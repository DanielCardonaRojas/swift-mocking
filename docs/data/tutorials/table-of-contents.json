{"identifier":{"url":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","interfaceLanguage":"swift"},"variants":[{"paths":["\/tutorials\/table-of-contents"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"overview","metadata":{"title":"Meet SwiftMocking","role":"overview","categoryPathComponent":"Table-Of-Contents","category":"SwiftMocking","estimatedTime":"40min"},"hierarchy":{"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","paths":[]},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[{"title":"Meet SwiftMocking","action":{"overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"isActive":true,"overridingTitle":"Get started","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol","type":"reference"},"content":[{"inlineContent":[{"text":"Stop hand-writing mock classes. With SwiftMocking, one ","type":"text"},{"type":"codeVoice","code":"@Mockable"},{"text":" annotation turns any protocol into a fully featured mock: stub return values, match arguments with expressive matchers, drive callbacks, and verify every interaction — all type-safe, all local, no code generation steps in your build.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These tutorials walk you from your first generated mock to verifying call order across multiple mocks, using the same "},{"code":"when","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"verify","type":"codeVoice"},{"text":" vocabulary throughout.","type":"text"}],"type":"paragraph"}],"kind":"hero","image":"intro.png","backgroundImage":"intro.png"},{"kind":"volume","image":null,"content":[],"name":null,"chapters":[{"name":"Getting Started","tutorials":["doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol"],"image":"chapter-getting-started.png","content":[{"type":"paragraph","inlineContent":[{"text":"Generate your first mock from a protocol, control what its methods return, and prove your code called them.","type":"text"}]}]},{"name":"Argument Matching","tutorials":["doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments"],"image":"chapter-matching.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decide exactly which calls your stubs answer and which calls your verifications count — from any value, to exact values, to ranges and custom predicates."}]}]},{"name":"Advanced Stubbing and Verification","tutorials":["doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing","doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions"],"image":"chapter-advanced.png","content":[{"inlineContent":[{"type":"text","text":"Compute returns from the arguments themselves, run side effects, drive callback-based APIs, and assert the order of calls across multiple mocks."}],"type":"paragraph"}]}]}],"references":{"chapter-matching.png":{"identifier":"chapter-matching.png","type":"image","alt":"Three argument values flowing into a funnel, with only one passing through to the other side.","variants":[{"traits":["1x","light"],"url":"\/images\/SwiftMocking\/chapter-matching.png"}]},"doc://SwiftMocking/tutorials/Table-Of-Contents":{"url":"\/tutorials\/table-of-contents","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","kind":"overview","type":"topic","title":"Meet SwiftMocking","role":"overview","abstract":[{"text":"Stop hand-writing mock classes. With SwiftMocking, one ","type":"text"},{"type":"codeVoice","code":"@Mockable"},{"text":" annotation turns any protocol into a fully featured mock: stub return values, match arguments with expressive matchers, drive callbacks, and verify every interaction — all type-safe, all local, no code generation steps in your build.","type":"text"}]},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing":{"title":"Stub Dynamically","estimatedTime":"10min","abstract":[{"type":"text","text":"Fixed return values only go so far. Real dependencies "},{"type":"emphasis","inlineContent":[{"text":"compute","type":"text"}]},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}],"role":"project","kind":"project","type":"topic","url":"\/tutorials\/swiftmocking\/dynamic-stubbing","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing"},"intro.png":{"type":"image","identifier":"intro.png","variants":[{"url":"\/images\/SwiftMocking\/intro.png","traits":["1x","light"]}],"alt":"The word SwiftMocking over a stylized code editor window showing a when stub and a verify assertion."},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions":{"url":"\/tutorials\/swiftmocking\/verifying-interactions","role":"project","estimatedTime":"10min","kind":"project","type":"topic","abstract":[{"text":"You’ve verified counts and matched arguments. This page completes the toolkit: asserting a call happened ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"never"}]},{"type":"text","text":", proving a mock was "},{"type":"emphasis","inlineContent":[{"type":"text","text":"untouched"}]},{"type":"text","text":", and — the signature feature — verifying the "},{"type":"emphasis","inlineContent":[{"text":"order","type":"text"}]},{"type":"text","text":" of calls as they happened across multiple mocks."}],"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions","title":"Verify Every Interaction"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol":{"url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol","type":"topic","title":"Mock Your First Protocol","role":"project","abstract":[{"text":"In this tutorial you’ll test a ","type":"text"},{"code":"Store","type":"codeVoice"},{"text":" that depends on a ","type":"text"},{"code":"PricingService","type":"codeVoice"},{"text":" — without writing a mock class by hand. You’ll mark a protocol with ","type":"text"},{"code":"@Mockable","type":"codeVoice"},{"text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it.","type":"text"}]},"chapter-advanced.png":{"variants":[{"url":"\/images\/SwiftMocking\/chapter-advanced.png","traits":["1x","light"]}],"alt":"A timeline of recorded method calls across two mock objects, with checkmarks confirming their order.","type":"image","identifier":"chapter-advanced.png"},"doc://SwiftMocking/tutorials/SwiftMocking/matching-arguments":{"url":"\/tutorials\/swiftmocking\/matching-arguments","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments","type":"topic","title":"Match Arguments Precisely","role":"project","abstract":[{"type":"text","text":"Stubbing "},{"type":"codeVoice","code":"\"apple\""},{"type":"text","text":" and verifying "},{"type":"codeVoice","code":".any"},{"type":"text","text":" is just the beginning. Real tests need finer control: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"any"}]},{"text":" amount, amounts ","type":"text"},{"inlineContent":[{"type":"text","text":"under"}],"type":"emphasis"},{"type":"text","text":" 100, codes "},{"inlineContent":[{"text":"in","type":"text"}],"type":"emphasis"},{"text":" a range, collections ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"of a certain size"}]},{"type":"text","text":" — or some predicate only you can express."}]},"chapter-getting-started.png":{"type":"image","identifier":"chapter-getting-started.png","alt":"A protocol declaration on the left transforming into a mock class card on the right, joined by an arrow.","variants":[{"url":"\/images\/SwiftMocking\/chapter-getting-started.png","traits":["1x","light"]}]}}}