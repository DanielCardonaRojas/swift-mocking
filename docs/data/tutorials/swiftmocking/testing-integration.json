s."}],"type":"topic","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments","title":"Match Arguments Precisely","estimatedTime":"10min","url":"\/tutorials\/swiftmocking\/matching-arguments","role":"project"}}}