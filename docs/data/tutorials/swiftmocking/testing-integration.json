{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","paths":[["doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/$volume","doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Swift-Testing-Integration"]],"modules":[{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Mark-a-protocol-as-mockable"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Create-the-system-under-test"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Stub-return-values-with-when"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Verify-the-interaction"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Getting-Started"},{"projects":[{"sections":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-any-or-exactly-one","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-with-predicates-and-ranges","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Capture-and-inspect-arguments","kind":"task"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Argument-Matching"},{"projects":[{"sections":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Return-computed-values","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Order-your-stubs","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Understand-matcher-precedence","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Run-side-effects-with-do","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Drive-callback-based-APIs","kind":"task"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing"},{"sections":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Assert-call-counts","kind":"task"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-order-across-mocks"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-thrown-errors","kind":"task"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Wait-for-calls-that-havent-happened-yet"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-property-reads-and-writes"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Debug-failing-verifications"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Advanced-Stubbing-and-Verification"},{"projects":[{"sections":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Control-what-unstubbed-requirements-return","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Mock-static-requirements-safely","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Use-the-rest-of-Swift-Testings-vocabulary","kind":"task"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Swift-Testing-Integration"}]},"identifier":{"url":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration","interfaceLanguage":"swift"},"sections":[{"image":"chapter-advanced.png","estimatedTimeInMinutes":15,"title":"Swift Testing, Defaults, and Statics","chapter":"Swift Testing Integration","kind":"hero","backgroundImage":"chapter-advanced.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every test so far has been an ordinary "},{"code":"@Test","type":"codeVoice"},{"type":"text","text":". This page covers what Swift Testing adds on top: "},{"inlineContent":[{"type":"text","text":"traits"}],"type":"strong"},{"type":"text","text":", which scope behavior to a test or a whole suite."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two traits matter for mocking. "},{"code":".withDefaults(_:)","type":"codeVoice"},{"type":"text","text":" decides what an "},{"inlineContent":[{"type":"text","text":"unstubbed"}],"type":"emphasis"},{"type":"text","text":" requirement returns, so a mock with fifty methods needs stubs only for the handful your test cares about. "},{"code":".mocking","type":"codeVoice"},{"type":"text","text":" gives a test its own spy storage, which is what makes "},{"inlineContent":[{"type":"text","text":"static"}],"type":"strong"},{"type":"text","text":" requirements safe when tests run in parallel."}]}]},{"tasks":[{"title":"Control what unstubbed requirements return","stepsSection":[{"code":"05-1-1-profile.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Start with a protocol whose requirements return three different types."}]}],"media":null,"caption":[],"type":"step","runtimePreview":null},{"code":"05-1-2-defaults.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call every requirement without stubbing anything. Each returns the zero value for its type — useful when a dependency is irrelevant to what you’re testing, and you’d rather not write stubs just to keep it quiet."}]}],"media":null,"caption":[],"type":"step","runtimePreview":null},{"code":"05-1-3-defaults.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now attach "},{"type":"codeVoice","code":".withDefaults(_:)"},{"type":"text","text":". It takes a variadic list of values and matches them to requirements "},{"inlineContent":[{"text":"by return type","type":"text"}],"type":"strong"},{"type":"text","text":" — so "},{"type":"codeVoice","code":"\"Guest\""},{"type":"text","text":" answers every unstubbed "},{"type":"codeVoice","code":"String"},{"type":"text","text":", "},{"type":"codeVoice","code":"5"},{"type":"text","text":" every "},{"type":"codeVoice","code":"Int"},{"type":"text","text":", and "},{"type":"codeVoice","code":"true"},{"type":"text","text":" every "},{"type":"codeVoice","code":"Bool"},{"type":"text","text":"."}]}],"media":null,"caption":[],"type":"step","runtimePreview":null},{"code":"05-1-4-defaults.swift","content":[{"type":"paragraph","inlineContent":[{"text":"The trait works at suite level too, and nests: a suite sets the baseline, a test overrides it, and an explicit ","type":"text"},{"type":"codeVoice","code":"when"},{"text":" stub beats both. Defaults are the fallback of last resort, and they’re scoped — a test without the trait is unaffected by one that has it.","type":"text"}]}],"media":null,"caption":[],"type":"step","runtimePreview":null}],"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Calling a method you never stubbed doesn’t trap — it returns a registered default for the return type: "},{"type":"codeVoice","code":"\"\""},{"type":"text","text":" for "},{"type":"codeVoice","code":"String"},{"type":"text","text":", "},{"type":"codeVoice","code":"0"},{"type":"text","text":" for numbers, "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":"Bool"},{"type":"text","text":", empty collections, "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for optionals."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That’s a sensible baseline, but it’s rarely the value your test wants. "},{"type":"codeVoice","code":".withDefaults(_:)"},{"type":"text","text":" replaces it for the scope of a test or suite."}]}],"media":"chapter-getting-started.png","kind":"contentAndMedia","mediaPosition":"trailing"}],"anchor":"Control-what-unstubbed-requirements-return"},{"title":"Mock static requirements safely","stepsSection":[{"code":"05-2-1-clock.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Declare a protocol with a static method and a static property. The macro generates static members on the mock to match.","type":"text"}]}],"media":null,"caption":[],"type":"step","runtimePreview":null},{"code":"05-2-2-static.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Stub and verify the static method on the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"type","type":"text"}]},{"text":" — ","type":"text"},{"type":"codeVoice","code":"MockClock.now()"},{"text":" — rather than on an instance. The ","type":"text"},{"type":"codeVoice","code":".mocking"},{"text":" trait is what keeps this test’s static calls to itself.","type":"text"}]}],"media":null,"caption":[],"type":"step","runtimePreview":null},{"code":"05-2-3-static.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Add a second test to prove the isolation. It opens by asserting ","type":"text"},{"type":"codeVoice","code":"neverCalled()"},{"text":", which would fail if the previous test’s invocations were still visible — exactly the flake ","type":"text"},{"type":"codeVoice","code":".mocking"},{"text":" prevents.","type":"text"}]}],"media":null,"caption":[],"type":"step","runtimePreview":null},{"code":"05-2-4-static.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Static properties follow the same pattern: stub the type member, read it, verify the read.","type":"text"}]}],"media":null,"caption":[],"type":"step","runtimePreview":null},{"code":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Reach for ","type":"text"},{"type":"codeVoice","code":".mocking"},{"text":" whenever a test touches static requirements or uses ","type":"text"},{"type":"codeVoice","code":"verifyInOrder"},{"text":", since the cross-spy timeline is shared state too. It’s harmless on tests that need neither, so applying it at suite level is a reasonable default.","type":"text"}]}],"media":null,"caption":[],"type":"step","runtimePreview":null}],"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Static requirements have no instance to hang state on, so their spies live in shared storage. Under Swift Testing — which runs tests in parallel by default — that shared storage is a race waiting to happen.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":".mocking"},{"text":" trait solves it by binding fresh, task-local spy storage for the duration of a test.","type":"text"}]}],"media":"chapter-advanced.png","kind":"contentAndMedia","mediaPosition":"trailing"}],"anchor":"Mock-static-requirements-safely"},{"title":"Use the rest of Swift Testing's vocabulary","stepsSection":[{"code":"05-3-1-parameterized.swift","content":[{"type":"paragraph","inlineContent":[{"text":"A parameterized ","type":"text"},{"code":"@Test","type":"codeVoice"},{"text":" runs once per argument, each with a fresh mock. Note the matcher: ","type":"text"},{"code":"item","type":"codeVoice"},{"text":" is a runtime value rather than a literal, so it needs an explicit ","type":"text"},{"code":".equal(item)","type":"codeVoice"},{"text":" — the bare-literal shorthand only applies to literals.","type":"text"}]}],"media":null,"caption":[],"type":"step","runtimePreview":null},{"code":"05-3-2-expect-throws.swift","content":[{"inlineContent":[{"type":"text","text":"For failures you have two complementary assertions. "},{"code":"#expect(throws:)","type":"codeVoice"},{"type":"text","text":" checks what the "},{"inlineContent":[{"type":"text","text":"call site"}],"type":"emphasis"},{"type":"text","text":" saw; "},{"code":"verify(...).throws(...)","type":"codeVoice"},{"text":" checks what the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"mock"}]},{"text":" recorded. Using both pins down the error’s whole round trip.","type":"text"}],"type":"paragraph"}],"media":null,"caption":[],"type":"step","runtimePreview":null},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"One habit carries over from every section: call the mock through a "},{"type":"strong","inlineContent":[{"text":"protocol-typed reference","type":"text"}]},{"text":" when passing literal arguments. On the mock type itself, ","type":"text"},{"type":"codeVoice","code":"mock.price(for: \"apple\")"},{"text":" resolves to the interaction overload and returns a description instead of calling through.","type":"text"}]}],"type":"step","caption":[],"media":null,"runtimePreview":null,"code":null}],"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Mocks compose with the framework’s other features. Two come up constantly: parameterized tests, which run one body across many inputs, and ","type":"text"},{"type":"codeVoice","code":"#expect(throws:)"},{"text":", which asserts at the call site.","type":"text"}]}],"media":"intro-matching.png","kind":"contentAndMedia","mediaPosition":"trailing"}],"anchor":"Use-the-rest-of-Swift-Testings-vocabulary"}],"kind":"tasks"}],"metadata":{"category":"SwiftMocking","categoryPathComponent":"Table-Of-Contents","title":"Swift Testing, Defaults, and Statics","role":"project"},"kind":"project","variants":[{"paths":["\/tutorials\/swiftmocking\/testing-integration"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftMocking/tutorials/SwiftMocking/testing-integration#Use-the-rest-of-Swift-Testings-vocabulary":{"kind":"section","url":"\/tutorials\/swiftmocking\/testing-integration#Use-the-rest-of-Swift-Testings-vocabulary","type":"section","abstract":[{"text":"Every test so far has been an ordinary ","type":"text"},{"code":"@Test","type":"codeVoice"},{"text":". This page covers what Swift Testing adds on top: ","type":"text"},{"inlineContent":[{"type":"text","text":"traits"}],"type":"strong"},{"text":", which scope behavior to a test or a whole suite.","type":"text"}],"title":"Use the rest of Swift Testing's vocabulary","role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Use-the-rest-of-Swift-Testings-vocabulary"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Verify-property-reads-and-writes":{"type":"section","abstract":[{"type":"text","text":"You’ve verified counts and matched arguments. This page completes the toolkit: counting calls with the full matcher vocabulary, asserting a call happened "},{"type":"emphasis","inlineContent":[{"type":"text","text":"never"}]},{"type":"text","text":", proving a mock was "},{"type":"emphasis","inlineContent":[{"type":"text","text":"untouched"}]},{"type":"text","text":", verifying thrown errors, waiting for calls that arrive from another task, distinguishing property reads from writes, and — the signature feature — verifying the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"order"}]},{"type":"text","text":" of calls across multiple mocks."}],"title":"Verify property reads and writes","url":"\/tutorials\/swiftmocking\/verifying-interactions#Verify-property-reads-and-writes","kind":"section","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-property-reads-and-writes","role":"pseudoSymbol"},"doc://SwiftMocking/tutorials/Table-Of-Contents":{"kind":"overview","type":"topic","url":"\/tutorials\/table-of-contents","role":"overview","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","abstract":[{"text":"Stop hand-writing mock classes. With SwiftMocking, one ","type":"text"},{"type":"codeVoice","code":"@Mockable"},{"text":" annotation turns any protocol into a fully featured mock: stub return values, match arguments with expressive matchers, drive callbacks, and verify every interaction — all type-safe, all local, no code generation steps in your build.","type":"text"}],"title":"Meet SwiftMocking"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Assert-call-counts":{"abstract":[{"text":"You’ve verified counts and matched arguments. This page completes the toolkit: counting calls with the full matcher vocabulary, asserting a call happened ","type":"text"},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"text":", proving a mock was ","type":"text"},{"inlineContent":[{"type":"text","text":"untouched"}],"type":"emphasis"},{"text":", verifying thrown errors, waiting for calls that arrive from another task, distinguishing property reads from writes, and — the signature feature — verifying the ","type":"text"},{"inlineContent":[{"type":"text","text":"order"}],"type":"emphasis"},{"text":" of calls across multiple mocks.","type":"text"}],"role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Assert-call-counts","type":"section","kind":"section","url":"\/tutorials\/swiftmocking\/verifying-interactions#Assert-call-counts","title":"Assert call counts"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Verify-order-across-mocks":{"abstract":[{"text":"You’ve verified counts and matched arguments. This page completes the toolkit: counting calls with the full matcher vocabulary, asserting a call happened ","type":"text"},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"text":", proving a mock was ","type":"text"},{"inlineContent":[{"type":"text","text":"untouched"}],"type":"emphasis"},{"text":", verifying thrown errors, waiting for calls that arrive from another task, distinguishing property reads from writes, and — the signature feature — verifying the ","type":"text"},{"inlineContent":[{"type":"text","text":"order"}],"type":"emphasis"},{"text":" of calls across multiple mocks.","type":"text"}],"role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-order-across-mocks","type":"section","kind":"section","url":"\/tutorials\/swiftmocking\/verifying-interactions#Verify-order-across-mocks","title":"Verify order across mocks"},"doc://SwiftMocking/tutorials/SwiftMocking/matching-arguments":{"type":"topic","abstract":[{"type":"text","text":"Stubbing "},{"code":"\"apple\"","type":"codeVoice"},{"type":"text","text":" and verifying "},{"code":".any","type":"codeVoice"},{"type":"text","text":" is just the beginning. Real tests need finer control: "},{"type":"emphasis","inlineContent":[{"text":"any","type":"text"}]},{"type":"text","text":" amount, amounts "},{"type":"emphasis","inlineContent":[{"type":"text","text":"under"}]},{"text":" 100, codes ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"in"}]},{"type":"text","text":" a range, collections "},{"inlineContent":[{"type":"text","text":"of a certain size"}],"type":"emphasis"},{"text":" — or some predicate only you can express.","type":"text"}],"title":"Match Arguments Precisely","url":"\/tutorials\/swiftmocking\/matching-arguments","kind":"project","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments","estimatedTime":"10min","role":"project"},"doc://SwiftMocking/tutorials/Table-Of-Contents/Advanced-Stubbing-and-Verification":{"abstract":[],"role":"article","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Advanced-Stubbing-and-Verification","type":"topic","kind":"article","url":"\/tutorials\/table-of-contents\/advanced-stubbing-and-verification","title":"Advanced Stubbing and Verification"},"05-3-2-expect-throws.swift":{"type":"file","fileType":"swift","identifier":"05-3-2-expect-throws.swift","fileName":"PaymentTests.swift","syntax":"swift","highlights":[],"content":["import SwiftMocking","import Testing","","@Test","func reportsInsufficientFunds() throws {","    let mock = MockPaymentService()","    when(mock.charge(amountCents: .any)).thenThrow(PaymentError(code: 42))","","    let service: any PaymentService = mock","","    \/\/ Swift Testing asserts thrown errors at the call site with","    \/\/ `#expect(throws:)` — the counterpart to XCTAssertThrowsError.","    #expect(throws: PaymentError.self) {","        _ = try service.charge(amountCents: 5000)","    }","","    \/\/ And SwiftMocking asserts it from the mock's side.","    verify(mock.charge(amountCents: .any)).throws(.error(PaymentError.self))","}"]},"05-2-3-static.swift":{"content":["import SwiftMocking","import Testing","","@Suite","struct ClockTests {","    \/\/ `.mocking` gives this test its own spy storage, so static","    \/\/ state can't leak in from — or out to — tests running in parallel.","    @Test(.mocking)","    func stubsAStaticMethod() {","        when(MockClock.now()).thenReturn(42)","","        #expect(MockClock.now() == 42)","","        verify(MockClock.now()).called(1)","    }","","    \/\/ A second test in the same suite. Without `.mocking` these two","    \/\/ would share static storage and race when run in parallel.","    @Test(.mocking)","    func startsFromACleanSlate() {","        \/\/ The other test's calls are invisible here.","        verify(MockClock.now()).neverCalled()","","        when(MockClock.now()).thenReturn(7)","        #expect(MockClock.now() == 7)","        verify(MockClock.now()).called(1)","    }","}"],"fileType":"swift","type":"file","fileName":"ClockTests.swift","highlights":[{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26},{"line":27}],"identifier":"05-2-3-static.swift","syntax":"swift"},"doc://SwiftMocking/tutorials/Table-Of-Contents/Getting-Started":{"abstract":[],"role":"article","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Getting-Started","type":"topic","kind":"article","url":"\/tutorials\/table-of-contents\/getting-started","title":"Getting Started"},"05-2-4-static.swift":{"identifier":"05-2-4-static.swift","syntax":"swift","fileType":"swift","content":["import SwiftMocking","import Testing","","@Suite","struct ClockTests {","    @Test(.mocking)","    func stubsAStaticMethod() {","        when(MockClock.now()).thenReturn(42)","        #expect(MockClock.now() == 42)","        verify(MockClock.now()).called(1)","    }","","    @Test(.mocking)","    func startsFromACleanSlate() {","        verify(MockClock.now()).neverCalled()","        when(MockClock.now()).thenReturn(7)","        #expect(MockClock.now() == 7)","        verify(MockClock.now()).called(1)","    }","","    \/\/ Static *properties* work the same way.","    @Test(.mocking)","    func stubsAStaticProperty() {","        when(MockClock.timeZone).thenReturn(\"UTC\")","","        #expect(MockClock.timeZone == \"UTC\")","","        verify(MockClock.timeZone).called(1)","    }","}"],"fileName":"ClockTests.swift","highlights":[{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28}],"type":"file"},"intro-matching.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/SwiftMocking\/intro-matching.png"}],"identifier":"intro-matching.png","alt":"A single test body fanning out into several argument pairs.","type":"image"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Understand-matcher-precedence":{"kind":"section","url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Understand-matcher-precedence","type":"section","abstract":[{"text":"Fixed return values only go so far. Real dependencies ","type":"text"},{"inlineContent":[{"type":"text","text":"compute"}],"type":"emphasis"},{"text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks.","type":"text"}],"title":"Understand matcher precedence","role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Understand-matcher-precedence"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Order-your-stubs":{"type":"section","abstract":[{"text":"Fixed return values only go so far. Real dependencies ","type":"text"},{"inlineContent":[{"type":"text","text":"compute"}],"type":"emphasis"},{"text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks.","type":"text"}],"title":"Order your stubs","url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Order-your-stubs","kind":"section","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Order-your-stubs","role":"pseudoSymbol"},"doc://SwiftMocking/tutorials/SwiftMocking/matching-arguments#Match-with-predicates-and-ranges":{"type":"section","abstract":[{"type":"text","text":"Stubbing "},{"type":"codeVoice","code":"\"apple\""},{"text":" and verifying ","type":"text"},{"code":".any","type":"codeVoice"},{"text":" is just the beginning. Real tests need finer control: ","type":"text"},{"inlineContent":[{"type":"text","text":"any"}],"type":"emphasis"},{"text":" amount, amounts ","type":"text"},{"inlineContent":[{"type":"text","text":"under"}],"type":"emphasis"},{"text":" 100, codes ","type":"text"},{"inlineContent":[{"text":"in","type":"text"}],"type":"emphasis"},{"text":" a range, collections ","type":"text"},{"inlineContent":[{"type":"text","text":"of a certain size"}],"type":"emphasis"},{"text":" — or some predicate only you can express.","type":"text"}],"title":"Match with predicates and ranges","url":"\/tutorials\/swiftmocking\/matching-arguments#Match-with-predicates-and-ranges","kind":"section","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-with-predicates-and-ranges","role":"pseudoSymbol"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol#Stub-return-values-with-when":{"kind":"section","url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol#Stub-return-values-with-when","type":"section","abstract":[{"text":"In this tutorial you’ll test a ","type":"text"},{"code":"Store","type":"codeVoice"},{"text":" that depends on a ","type":"text"},{"code":"PricingService","type":"codeVoice"},{"text":" — without writing a mock class by hand. You’ll mark a protocol with ","type":"text"},{"code":"@Mockable","type":"codeVoice"},{"text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it.","type":"text"}],"title":"Stub return values with when","role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Stub-return-values-with-when"},"05-1-3-defaults.swift":{"type":"file","fileType":"swift","identifier":"05-1-3-defaults.swift","fileName":"UserProfileTests.swift","syntax":"swift","highlights":[],"content":["import SwiftMocking","import Testing","","\/\/ `.withDefaults` injects values for unstubbed requirements,","\/\/ matched by type. Here every unstubbed String returns \"Guest\".","@Test(.withDefaults(\"Guest\", 5, true))","func customDefaultsPerTest() {","    let mock = MockUserProfile()","    let profile: any UserProfile = mock","","    #expect(profile.displayName() == \"Guest\")","    #expect(profile.retryLimit() == 5)","    #expect(profile.isPremium() == true)","}"]},"chapter-getting-started.png":{"type":"image","identifier":"chapter-getting-started.png","variants":[{"traits":["1x","light"],"url":"\/images\/SwiftMocking\/chapter-getting-started.png"}],"alt":"An unstubbed method call falling through to a registry that supplies a default value."},"doc://SwiftMocking/tutorials/SwiftMocking/testing-integration#Mock-static-requirements-safely":{"abstract":[{"text":"Every test so far has been an ordinary ","type":"text"},{"code":"@Test","type":"codeVoice"},{"text":". This page covers what Swift Testing adds on top: ","type":"text"},{"type":"strong","inlineContent":[{"text":"traits","type":"text"}]},{"text":", which scope behavior to a test or a whole suite.","type":"text"}],"role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Mock-static-requirements-safely","type":"section","title":"Mock static requirements safely","url":"\/tutorials\/swiftmocking\/testing-integration#Mock-static-requirements-safely","kind":"section"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol":{"kind":"project","url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol","type":"topic","title":"Mock Your First Protocol","abstract":[{"text":"In this tutorial you’ll test a ","type":"text"},{"code":"Store","type":"codeVoice"},{"text":" that depends on a ","type":"text"},{"code":"PricingService","type":"codeVoice"},{"text":" — without writing a mock class by hand. You’ll mark a protocol with ","type":"text"},{"code":"@Mockable","type":"codeVoice"},{"text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it.","type":"text"}],"role":"project","estimatedTime":"10min","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Return-computed-values":{"kind":"section","url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Return-computed-values","type":"section","abstract":[{"text":"Fixed return values only go so far. Real dependencies ","type":"text"},{"inlineContent":[{"type":"text","text":"compute"}],"type":"emphasis"},{"text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks.","type":"text"}],"title":"Return computed values","role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Return-computed-values"},"doc://SwiftMocking/tutorials/SwiftMocking/testing-integration":{"kind":"project","url":"\/tutorials\/swiftmocking\/testing-integration","type":"topic","abstract":[{"type":"text","text":"Every test so far has been an ordinary "},{"code":"@Test","type":"codeVoice"},{"type":"text","text":". This page covers what Swift Testing adds on top: "},{"inlineContent":[{"type":"text","text":"traits"}],"type":"strong"},{"type":"text","text":", which scope behavior to a test or a whole suite."}],"title":"Swift Testing, Defaults, and Statics","role":"project","estimatedTime":"15min","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Wait-for-calls-that-havent-happened-yet":{"abstract":[{"text":"You’ve verified counts and matched arguments. This page completes the toolkit: counting calls with the full matcher vocabulary, asserting a call happened ","type":"text"},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"text":", proving a mock was ","type":"text"},{"inlineContent":[{"type":"text","text":"untouched"}],"type":"emphasis"},{"text":", verifying thrown errors, waiting for calls that arrive from another task, distinguishing property reads from writes, and — the signature feature — verifying the ","type":"text"},{"inlineContent":[{"type":"text","text":"order"}],"type":"emphasis"},{"text":" of calls across multiple mocks.","type":"text"}],"role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Wait-for-calls-that-havent-happened-yet","type":"section","kind":"section","url":"\/tutorials\/swiftmocking\/verifying-interactions#Wait-for-calls-that-havent-happened-yet","title":"Wait for calls that haven't happened yet"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Drive-callback-based-APIs":{"type":"section","abstract":[{"type":"text","text":"Fixed return values only go so far. Real dependencies "},{"type":"emphasis","inlineContent":[{"type":"text","text":"compute"}]},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}],"title":"Drive callback-based APIs","url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Drive-callback-based-APIs","kind":"section","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Drive-callback-based-APIs","role":"pseudoSymbol"},"doc://SwiftMocking/tutorials/Table-Of-Contents/Argument-Matching":{"type":"topic","abstract":[],"title":"Argument Matching","url":"\/tutorials\/table-of-contents\/argument-matching","kind":"article","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Argument-Matching","role":"article"},"05-3-1-parameterized.swift":{"type":"file","fileType":"swift","syntax":"swift","fileName":"PricingTests.swift","identifier":"05-3-1-parameterized.swift","highlights":[],"content":["import SwiftMocking","import Testing","","\/\/ One test, run once per argument pair.","@Test(arguments: [(\"apple\", 13), (\"banana\", 17)])","func pricesEachItem(item: String, expected: Int) {","    let mock = MockPricingService()","","    \/\/ `item` is a runtime value, not a literal — so the literal-to-matcher","    \/\/ sugar doesn't apply and you spell the matcher explicitly.","    when(mock.price(for: .equal(item))).thenReturn(expected)","","    let service: any PricingService = mock","    #expect(service.price(for: item) == expected)","","    verify(mock.price(for: .equal(item))).called(1)","}"]},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions":{"kind":"project","url":"\/tutorials\/swiftmocking\/verifying-interactions","type":"topic","title":"Verify Every Interaction","abstract":[{"type":"text","text":"You’ve verified counts and matched arguments. This page completes the toolkit: counting calls with the full matcher vocabulary, asserting a call happened "},{"inlineContent":[{"text":"never","type":"text"}],"type":"emphasis"},{"type":"text","text":", proving a mock was "},{"inlineContent":[{"text":"untouched","type":"text"}],"type":"emphasis"},{"type":"text","text":", verifying thrown errors, waiting for calls that arrive from another task, distinguishing property reads from writes, and — the signature feature — verifying the "},{"inlineContent":[{"text":"order","type":"text"}],"type":"emphasis"},{"type":"text","text":" of calls across multiple mocks."}],"role":"project","estimatedTime":"20min","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Verify-thrown-errors":{"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-thrown-errors","kind":"section","type":"section","role":"pseudoSymbol","title":"Verify thrown errors","abstract":[{"type":"text","text":"You’ve verified counts and matched arguments. This page completes the toolkit: counting calls with the full matcher vocabulary, asserting a call happened "},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"type":"text","text":", proving a mock was "},{"inlineContent":[{"text":"untouched","type":"text"}],"type":"emphasis"},{"type":"text","text":", verifying thrown errors, waiting for calls that arrive from another task, distinguishing property reads from writes, and — the signature feature — verifying the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"order"}]},{"text":" of calls across multiple mocks.","type":"text"}],"url":"\/tutorials\/swiftmocking\/verifying-interactions#Verify-thrown-errors"},"05-2-1-clock.swift":{"type":"file","fileType":"swift","identifier":"05-2-1-clock.swift","fileName":"Clock.swift","syntax":"swift","highlights":[],"content":["import SwiftMocking","","@Mockable","protocol Clock {","    static func now() -> Int","    static var timeZone: String { get }","}"]},"05-1-4-defaults.swift":{"identifier":"05-1-4-defaults.swift","syntax":"swift","content":["import SwiftMocking","import Testing","","\/\/ Applied to a @Suite, the trait covers every test inside it.","@Suite(.withDefaults(\"Anonymous\"))","struct ProfileTests {","    @Test","    func inheritsTheSuiteDefault() {","        let profile: any UserProfile = MockUserProfile()","        #expect(profile.displayName() == \"Anonymous\")","    }","","    \/\/ A test-level trait overrides the suite's value.","    @Test(.withDefaults(\"Override\"))","    func overridesTheSuiteDefault() {","        let profile: any UserProfile = MockUserProfile()","        #expect(profile.displayName() == \"Override\")","    }","","    \/\/ An explicit stub always beats any default.","    @Test","    func explicitStubStillWins() {","        let mock = MockUserProfile()","        when(mock.displayName()).thenReturn(\"Explicit\")","        let profile: any UserProfile = mock","        #expect(profile.displayName() == \"Explicit\")","    }","}"],"fileType":"swift","fileName":"UserProfileTests.swift","highlights":[],"type":"file"},"05-1-1-profile.swift":{"content":["import SwiftMocking","","@Mockable","protocol UserProfile {","    func displayName() -> String","    func retryLimit() -> Int","    func isPremium() -> Bool","}"],"fileType":"swift","type":"file","fileName":"UserProfile.swift","highlights":[],"identifier":"05-1-1-profile.swift","syntax":"swift"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol#Verify-the-interaction":{"type":"section","abstract":[{"type":"text","text":"In this tutorial you’ll test a "},{"type":"codeVoice","code":"Store"},{"type":"text","text":" that depends on a "},{"type":"codeVoice","code":"PricingService"},{"type":"text","text":" — without writing a mock class by hand. You’ll mark a protocol with "},{"type":"codeVoice","code":"@Mockable"},{"type":"text","text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it."}],"title":"Verify the interaction","url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol#Verify-the-interaction","kind":"section","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Verify-the-interaction","role":"pseudoSymbol"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol#Mark-a-protocol-as-mockable":{"kind":"section","url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol#Mark-a-protocol-as-mockable","type":"section","title":"Mark a protocol as mockable","abstract":[{"type":"text","text":"In this tutorial you’ll test a "},{"type":"codeVoice","code":"Store"},{"type":"text","text":" that depends on a "},{"type":"codeVoice","code":"PricingService"},{"type":"text","text":" — without writing a mock class by hand. You’ll mark a protocol with "},{"type":"codeVoice","code":"@Mockable"},{"type":"text","text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it."}],"role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Mark-a-protocol-as-mockable"},"doc://SwiftMocking/tutorials/SwiftMocking/testing-integration#Control-what-unstubbed-requirements-return":{"kind":"section","url":"\/tutorials\/swiftmocking\/testing-integration#Control-what-unstubbed-requirements-return","type":"section","abstract":[{"text":"Every test so far has been an ordinary ","type":"text"},{"code":"@Test","type":"codeVoice"},{"text":". This page covers what Swift Testing adds on top: ","type":"text"},{"inlineContent":[{"type":"text","text":"traits"}],"type":"strong"},{"text":", which scope behavior to a test or a whole suite.","type":"text"}],"title":"Control what unstubbed requirements return","role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Control-what-unstubbed-requirements-return"},"doc://SwiftMocking/tutorials/SwiftMocking/matching-arguments#Capture-and-inspect-arguments":{"abstract":[{"type":"text","text":"Stubbing "},{"type":"codeVoice","code":"\"apple\""},{"type":"text","text":" and verifying "},{"type":"codeVoice","code":".any"},{"type":"text","text":" is just the beginning. Real tests need finer control: "},{"type":"emphasis","inlineContent":[{"text":"any","type":"text"}]},{"text":" amount, amounts ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"under","type":"text"}]},{"text":" 100, codes ","type":"text"},{"inlineContent":[{"text":"in","type":"text"}],"type":"emphasis"},{"text":" a range, collections ","type":"text"},{"inlineContent":[{"type":"text","text":"of a certain size"}],"type":"emphasis"},{"type":"text","text":" — or some predicate only you can express."}],"role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Capture-and-inspect-arguments","type":"section","title":"Capture and inspect arguments","url":"\/tutorials\/swiftmocking\/matching-arguments#Capture-and-inspect-arguments","kind":"section"},"doc://SwiftMocking/tutorials/Table-Of-Contents/Swift-Testing-Integration":{"kind":"article","url":"\/tutorials\/table-of-contents\/swift-testing-integration","type":"topic","abstract":[],"title":"Swift Testing Integration","role":"article","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Swift-Testing-Integration"},"05-2-2-static.swift":{"highlights":[],"fileType":"swift","type":"file","fileName":"ClockTests.swift","content":["import SwiftMocking","import Testing","","@Suite","struct ClockTests {","    \/\/ `.mocking` gives this test its own spy storage, so static","    \/\/ state can't leak in from — or out to — tests running in parallel.","    @Test(.mocking)","    func stubsAStaticMethod() {","        when(MockClock.now()).thenReturn(42)","","        #expect(MockClock.now() == 42)","","        verify(MockClock.now()).called(1)","    }","}"],"identifier":"05-2-2-static.swift","syntax":"swift"},"05-1-2-defaults.swift":{"highlights":[],"fileType":"swift","type":"file","fileName":"UserProfileTests.swift","content":["import SwiftMocking","import Testing","","@Test","func unstubbedRequirementsFallBackToZeroValues() {","    let mock = MockUserProfile()","    let profile: any UserProfile = mock","","    \/\/ Nothing is stubbed. Rather than trapping, each requirement","    \/\/ returns the registered default for its type.","    #expect(profile.displayName() == \"\")","    #expect(profile.retryLimit() == 0)","    #expect(profile.isPremium() == false)","}"],"identifier":"05-1-2-defaults.swift","syntax":"swift"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Run-side-effects-with-do":{"kind":"section","url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Run-side-effects-with-do","type":"section","abstract":[{"text":"Fixed return values only go so far. Real dependencies ","type":"text"},{"inlineContent":[{"type":"text","text":"compute"}],"type":"emphasis"},{"text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks.","type":"text"}],"title":"Run side effects with do","role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Run-side-effects-with-do"},"chapter-advanced.png":{"identifier":"chapter-advanced.png","type":"image","alt":"Two parallel tests each holding a separate copy of static mock storage.","variants":[{"traits":["1x","light"],"url":"\/images\/SwiftMocking\/chapter-advanced.png"}]},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Debug-failing-verifications":{"kind":"section","url":"\/tutorials\/swiftmocking\/verifying-interactions#Debug-failing-verifications","type":"section","abstract":[{"text":"You’ve verified counts and matched arguments. This page completes the toolkit: counting calls with the full matcher vocabulary, asserting a call happened ","type":"text"},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"text":", proving a mock was ","type":"text"},{"inlineContent":[{"text":"untouched","type":"text"}],"type":"emphasis"},{"type":"text","