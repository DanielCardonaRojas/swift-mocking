{"kind":"project","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/swiftmocking\/dynamic-stubbing"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"category":"SwiftMocking","title":"Stub Dynamically","categoryPathComponent":"Table-Of-Contents","role":"project"},"sections":[{"estimatedTimeInMinutes":10,"kind":"hero","backgroundImage":"intro-dynamic.png","chapter":"Advanced Stubbing and Verification","title":"Stub Dynamically","content":[{"type":"paragraph","inlineContent":[{"text":"Fixed return values only go so far. Real dependencies ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"compute","type":"text"}]},{"text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this tutorial you’ll stub with closures that receive the actual arguments — fully typed, no casting — learn how overlapping stubs resolve, register side effects, and drive callback-based APIs on your terms."}]}],"image":"intro-dynamic.png"},{"tasks":[{"title":"Return computed values","contentSection":[{"content":[{"inlineContent":[{"text":"Instead of handing ","type":"text"},{"code":"thenReturn","type":"codeVoice"},{"text":" a value, hand it a closure. The closure’s parameters are the mocked method’s parameters — concrete types guaranteed by parameter packs. You are, in effect, substituting the method’s implementation.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing","media":"intro-dynamic.png"}],"anchor":"Return-computed-values","stepsSection":[{"media":null,"caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a "},{"type":"codeVoice","code":"Calculator"},{"type":"text","text":" protocol and mark it mockable:"}]}],"runtimePreview":null,"type":"step","code":"03-1-1-calculator.swift"},{"media":null,"caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stub multiplication with a closure instead of a value. Note that "},{"code":"a","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"b"},{"type":"text","text":" are plain "},{"type":"codeVoice","code":"Int"},{"type":"text","text":"s — there is no casting, ever:"}]}],"runtimePreview":null,"type":"step","code":"03-1-2-computed.swift"},{"code":"03-1-3-computed.swift","media":null,"caption":[],"content":[{"inlineContent":[{"type":"text","text":"Call the mock and the closure runs with the real arguments, so the result depends on what was passed rather than on a value fixed at stub time."}],"type":"paragraph"}],"runtimePreview":null,"type":"step"}]},{"title":"Order your stubs","contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"text":"Stubs with different matchers coexist: the most specific matcher that matches a call answers it. When you register another stub for the ","type":"text"},{"inlineContent":[{"text":"same","type":"text"}],"type":"emphasis"},{"text":" matcher, the later registration wins.","type":"text"}],"type":"paragraph"}],"media":"chapter-advanced.png","kind":"contentAndMedia"}],"anchor":"Order-your-stubs","stepsSection":[{"runtimePreview":null,"content":[{"inlineContent":[{"text":"Define a reusable matcher. Binding it to a ","type":"text"},{"type":"codeVoice","code":"let"},{"text":" keeps the stubs below readable and makes the intent — “odd operands” — explicit.","type":"text"}],"type":"paragraph"}],"media":null,"caption":[],"type":"step","code":"03-2-1-ordering.swift"},{"code":"03-2-2-ordering.swift","runtimePreview":null,"media":null,"type":"step","content":[{"inlineContent":[{"text":"Register the specific matcher first and the broad fallback last. Both stubs stay live; the more specific one simply takes precedence when it matches.","type":"text"}],"type":"paragraph"}],"caption":[]},{"media":null,"type":"step","caption":[],"code":"03-2-3-ordering.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Exercise both paths. Two odd operands hit the specific stub and multiply; a mixed pair falls through to "},{"code":".any","type":"codeVoice"},{"text":" and adds.","type":"text"}]}]}]},{"stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare a "},{"type":"codeVoice","code":"SyncEngine"},{"text":" dependency whose refresh method returns ","type":"text"},{"type":"codeVoice","code":"Void"},{"text":":","type":"text"}]}],"caption":[],"media":null,"code":"03-3-1-sync-engine.swift","runtimePreview":null,"type":"step"},{"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First, somewhere to record. "},{"type":"codeVoice","code":".do"},{"text":" handlers are ","type":"text"},{"type":"codeVoice","code":"@Sendable"},{"type":"text","text":", so a captured "},{"type":"codeVoice","code":"var"},{"type":"text","text":" won’t compile under the Swift 6 language mode — put the state behind a small lock-guarded class instead."}]}],"code":"03-3-2-side-effects.swift","runtimePreview":null,"caption":[],"type":"step"},{"runtimePreview":null,"type":"step","caption":[],"content":[{"inlineContent":[{"text":"Register the action with ","type":"text"},{"code":".do","type":"codeVoice"},{"text":". It observes each matching call and its arguments, but deliberately contributes no return value.","type":"text"}],"type":"paragraph"}],"media":null,"code":"03-3-3-side-effects.swift"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pair it with a "},{"type":"codeVoice","code":"thenReturn(())"},{"type":"text","text":" stub for the same matcher so the call itself resolves cleanly, then drive two refreshes. Reading "},{"type":"codeVoice","code":"refreshed.values"},{"type":"text","text":" shows both, in order, and "},{"type":"codeVoice","code":"verify"},{"type":"text","text":" confirms the count."}]}],"runtimePreview":null,"media":null,"type":"step","caption":[],"code":"03-3-4-side-effects.swift"}],"title":"Run side effects with do","anchor":"Run-side-effects-with-do","contentSection":[{"media":"intro-dynamic.png","kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"Sometimes you want to observe or record without changing the response. "},{"type":"codeVoice","code":".do"},{"text":" registers an action alongside the stub — it runs with the call’s arguments whenever a matching invocation occurs.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing"}]},{"contentSection":[{"media":"chapter-advanced.png","mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"Completion-handler APIs are where mocks earn their keep. Match the closure parameter with ","type":"text"},{"type":"codeVoice","code":".any"},{"text":" — the only matcher that makes sense for it — then invoke the completion yourself from a ","type":"text"},{"type":"codeVoice","code":"thenReturn"},{"text":" closure. You decide when and with what the callback fires.","type":"text"}]}]}],"stepsSection":[{"type":"step","media":null,"code":"03-4-1-network-service.swift","runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Declare a "},{"code":"NetworkService","type":"codeVoice"},{"type":"text","text":" protocol with a completion handler, plus a small "},{"code":"User","type":"codeVoice"},{"type":"text","text":" model:"}],"type":"paragraph"}],"caption":[]},{"type":"step","media":null,"code":"03-4-2-callbacks.swift","runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Set up the test with a "},{"type":"codeVoice","code":"confirmation"},{"type":"text","text":". It’s Swift Testing’s replacement for "},{"type":"codeVoice","code":"XCTestExpectation"},{"type":"text","text":", and it’s what proves the completion actually fired rather than being silently dropped — the body must confirm exactly once before it returns."}],"type":"paragraph"}],"caption":[]},{"type":"step","media":null,"code":"03-4-3-callbacks.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Stub the call and invoke the completion yourself. The closure receives both the matched ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" — a real ","type":"text"},{"type":"codeVoice","code":"String"},{"type":"text","text":" — and the completion handler, so the result you deliver can depend on the argument that was passed."}]}],"caption":[]},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":"Issue.record","type":"codeVoice"},{"type":"text","text":" where XCTest would use "},{"code":"XCTFail","type":"codeVoice"},{"type":"text","text":"."}]}],"type":"step","media":null,"code":"03-4-4-callbacks.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call the mock and assert what arrives, calling "},{"type":"codeVoice","code":"received()"},{"type":"text","text":" inside the handler. Note the protocol-typed "},{"type":"codeVoice","code":"service"},{"type":"text","text":" reference: on the mock type a literal argument would resolve to the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"interaction"}]},{"type":"text","text":" overload and never call through."}]}]},{"runtimePreview":null,"media":null,"type":"step","code":null,"content":[{"inlineContent":[{"text":"Failures are one line away — deliver ","type":"text"},{"code":".failure(...)","type":"codeVoice"},{"text":" instead and your error paths become just as testable as the happy path.","type":"text"}],"type":"paragraph"}],"caption":[]}],"anchor":"Drive-callback-based-APIs","title":"Drive callback-based APIs"}],"kind":"tasks"},{"kind":"callToAction","abstract":[{"type":"text","text":"You’ve verified counts and matched arguments. This page completes the toolkit: counting calls with the full matcher vocabulary, asserting a call happened "},{"type":"emphasis","inlineContent":[{"type":"text","text":"never"}]},{"type":"text","text":", proving a mock was "},{"type":"emphasis","inlineContent":[{"type":"text","text":"untouched"}]},{"text":", verifying thrown errors, waiting for calls that arrive from another task, distinguishing property reads from writes, and — the signature feature — verifying the ","type":"text"},{"inlineContent":[{"type":"text","text":"order"}],"type":"emphasis"},{"type":"text","text":" of calls across multiple mocks."}],"action":{"type":"reference","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions","isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}]},"title":"Verify Every Interaction","featuredEyebrow":"Tutorial"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing"},"hierarchy":{"paths":[["doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/$volume","doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Advanced-Stubbing-and-Verification"]],"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","modules":[{"projects":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol","sections":[{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Mark-a-protocol-as-mockable"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Create-the-system-under-test"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Stub-return-values-with-when","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Verify-the-interaction","kind":"task"}]}],"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Getting-Started"},{"projects":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments","sections":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-any-or-exactly-one","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-with-predicates-and-ranges","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Capture-and-inspect-arguments","kind":"task"}]}],"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Argument-Matching"},{"projects":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing","sections":[{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Return-computed-values"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Order-your-stubs"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Run-side-effects-with-do"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Drive-callback-based-APIs"}]},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions","sections":[{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Assert-call-counts"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-order-across-mocks"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-thrown-errors"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Wait-for-calls-that-havent-happened-yet"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-property-reads-and-writes"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Debug-failing-verifications"}]}],"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Advanced-Stubbing-and-Verification"},{"projects":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration","sections":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Control-what-unstubbed-requirements-return","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Mock-static-requirements-safely","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Use-the-rest-of-Swift-Testings-vocabulary","kind":"task"}]}],"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Swift-Testing-Integration"}]},"references":{"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Return-computed-values":{"kind":"section","abstract":[{"type":"text","text":"Fixed return values only go so far. Real dependencies "},{"type":"emphasis","inlineContent":[{"type":"text","text":"compute"}]},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}],"type":"section","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Return-computed-values","title":"Return computed values","url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Return-computed-values","role":"pseudoSymbol"},"doc://SwiftMocking/tutorials/Table-Of-Contents/Advanced-Stubbing-and-Verification":{"title":"Advanced Stubbing and Verification","abstract":[],"kind":"article","url":"\/tutorials\/table-of-contents\/advanced-stubbing-and-verification","role":"article","type":"topic","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Advanced-Stubbing-and-Verification"},"03-4-4-callbacks.swift":{"syntax":"swift","fileName":"NetworkServiceTests.swift","content":["@Test","func fetchUserDeliversSuccess() async {","    let mock = MockNetworkService()","","    \/\/ Swift Testing replaces XCTestExpectation with `confirmation`.","    \/\/ The body must call `received()` exactly once before it returns.","    await confirmation(\"completion invoked\") { received in","        \/\/ .any is the only matcher that makes sense for a closure parameter.","        when(mock.fetchUser(id: .equal(\"42\"), completion: .any))","            .thenReturn { id, completion in","                completion(.success(User(id: id, name: \"Test User\")))","            }","","        let service: any NetworkService = mock","        service.fetchUser(id: \"42\") { result in","            guard case .success(let user) = result else {","                Issue.record(\"expected a success result\")","                return","            }","            #expect(user == User(id: \"42\", name: \"Test User\"))","            received()","        }","    }","","    verify(mock.fetchUser(id: .equal(\"42\"), completion: .any)).called(1)","}"],"highlights":[{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":24},{"line":25}],"type":"file","fileType":"swift","identifier":"03-4-4-callbacks.swift"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol#Verify-the-interaction":{"abstract":[{"type":"text","text":"In this tutorial you’ll test a "},{"type":"codeVoice","code":"Store"},{"type":"text","text":" that depends on a "},{"type":"codeVoice","code":"PricingService"},{"type":"text","text":" — without writing a mock class by hand. You’ll mark a protocol with "},{"type":"codeVoice","code":"@Mockable"},{"type":"text","text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it."}],"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Verify-the-interaction","kind":"section","role":"pseudoSymbol","url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol#Verify-the-interaction","type":"section","title":"Verify the interaction"},"doc://SwiftMocking/tutorials/Table-Of-Contents/Argument-Matching":{"role":"article","abstract":[],"kind":"article","type":"topic","title":"Argument Matching","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Argument-Matching","url":"\/tutorials\/table-of-contents\/argument-matching"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol#Mark-a-protocol-as-mockable":{"url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol#Mark-a-protocol-as-mockable","title":"Mark a protocol as mockable","abstract":[{"type":"text","text":"In this tutorial you’ll test a "},{"type":"codeVoice","code":"Store"},{"type":"text","text":" that depends on a "},{"type":"codeVoice","code":"PricingService"},{"type":"text","text":" — without writing a mock class by hand. You’ll mark a protocol with "},{"type":"codeVoice","code":"@Mockable"},{"type":"text","text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it."}],"kind":"section","role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Mark-a-protocol-as-mockable","type":"section"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Run-side-effects-with-do":{"url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Run-side-effects-with-do","title":"Run side effects with do","abstract":[{"text":"Fixed return values only go so far. Real dependencies ","type":"text"},{"inlineContent":[{"type":"text","text":"compute"}],"type":"emphasis"},{"text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks.","type":"text"}],"kind":"section","role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Run-side-effects-with-do","type":"section"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol#Stub-return-values-with-when":{"abstract":[{"type":"text","text":"In this tutorial you’ll test a "},{"type":"codeVoice","code":"Store"},{"type":"text","text":" that depends on a "},{"type":"codeVoice","code":"PricingService"},{"type":"text","text":" — without writing a mock class by hand. You’ll mark a protocol with "},{"type":"codeVoice","code":"@Mockable"},{"type":"text","text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it."}],"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Stub-return-values-with-when","kind":"section","role":"pseudoSymbol","url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol#Stub-return-values-with-when","title":"Stub return values with when","type":"section"},"doc://SwiftMocking/tutorials/SwiftMocking/testing-integration#Control-what-unstubbed-requirements-return":{"kind":"section","type":"section","abstract":[{"text":"Every test so far has been an ordinary ","type":"text"},{"code":"@Test","type":"codeVoice"},{"text":". This page covers what Swift Testing adds on top: ","type":"text"},{"inlineContent":[{"type":"text","text":"traits"}],"type":"strong"},{"text":", which scope behavior to a test or a whole suite.","type":"text"}],"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Control-what-unstubbed-requirements-return","role":"pseudoSymbol","url":"\/tutorials\/swiftmocking\/testing-integration#Control-what-unstubbed-requirements-return","title":"Control what unstubbed requirements return"},"doc://SwiftMocking/tutorials/SwiftMocking/matching-arguments#Match-with-predicates-and-ranges":{"url":"\/tutorials\/swiftmocking\/matching-arguments#Match-with-predicates-and-ranges","title":"Match with predicates and ranges","abstract":[{"type":"text","text":"Stubbing "},{"type":"codeVoice","code":"\"apple\""},{"text":" and verifying ","type":"text"},{"type":"codeVoice","code":".any"},{"type":"text","text":" is just the beginning. Real tests need finer control: "},{"inlineContent":[{"type":"text","text":"any"}],"type":"emphasis"},{"text":" amount, amounts ","type":"text"},{"inlineContent":[{"type":"text","text":"under"}],"type":"emphasis"},{"text":" 100, codes ","type":"text"},{"inlineContent":[{"text":"in","type":"text"}],"type":"emphasis"},{"text":" a range, collections ","type":"text"},{"inlineContent":[{"type":"text","text":"of a certain size"}],"type":"emphasis"},{"text":" — or some predicate only you can express.","type":"text"}],"kind":"section","role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-with-predicates-and-ranges","type":"section"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Debug-failing-verifications":{"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Debug-failing-verifications","kind":"section","title":"Debug failing verifications","url":"\/tutorials\/swiftmocking\/verifying-interactions#Debug-failing-verifications","role":"pseudoSymbol","type":"section","abstract":[{"text":"You’ve verified counts and matched arguments. This page completes the toolkit: counting calls with the full matcher vocabulary, asserting a call happened ","type":"text"},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"text":", proving a mock was ","type":"text"},{"inlineContent":[{"type":"text","text":"untouched"}],"type":"emphasis"},{"text":", verifying thrown errors, waiting for calls that arrive from another task, distinguishing property reads from writes, and — the signature feature — verifying the ","type":"text"},{"inlineContent":[{"text":"order","type":"text"}],"type":"emphasis"},{"text":" of calls across multiple mocks.","type":"text"}]},"03-4-3-callbacks.swift":{"type":"file","identifier":"03-4-3-callbacks.swift","fileName":"NetworkServiceTests.swift","fileType":"swift","highlights":[{"line":8},{"line":9},{"line":10},{"line":11},{"line":12}],"content":["@Test","func fetchUserDeliversSuccess() async {","    let mock = MockNetworkService()","","    \/\/ Swift Testing replaces XCTestExpectation with `confirmation`.","    \/\/ The body must call `received()` exactly once before it returns.","    await confirmation(\"completion invoked\") { received in","        \/\/ .any is the only matcher that makes sense for a closure parameter.","        when(mock.fetchUser(id: .equal(\"42\"), completion: .any))","            .thenReturn { id, completion in","                completion(.success(User(id: id, name: \"Test User\")))","            }","    }","}"],"syntax":"swift"},"03-4-2-callbacks.swift":{"syntax":"swift","fileName":"NetworkServiceTests.swift","content":["@Test","func fetchUserDeliversSuccess() async {","    let mock = MockNetworkService()","","    \/\/ Swift Testing replaces XCTestExpectation with `confirmation`.","    \/\/ The body must call `received()` exactly once before it returns.","    await confirmation(\"completion invoked\") { received in","    }","}"],"highlights":[],"type":"file","fileType":"swift","identifier":"03-4-2-callbacks.swift"},"03-4-1-network-service.swift":{"syntax":"swift","fileName":"NetworkService.swift","content":["import SwiftMocking","","struct User: Equatable {","    let id: String","    let name: String","}","","@Mockable","protocol NetworkService {","    func fetchUser(id: String, completion: @escaping (Result<User, Error>) -> Void)","}"],"highlights":[],"type":"file","fileType":"swift","identifier":"03-4-1-network-service.swift"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Assert-call-counts":{"abstract":[{"type":"text","text":"You’ve verified counts and matched arguments. This page completes the toolkit: counting calls with the full matcher vocabulary, asserting a call happened "},{"type":"emphasis","inlineContent":[{"type":"text","text":"never"}]},{"type":"text","text":", proving a mock was "},{"type":"emphasis","inlineContent":[{"text":"untouched","type":"text"}]},{"type":"text","text":", verifying thrown errors, waiting for calls that arrive from another task, distinguishing property reads from writes, and — the signature feature — verifying the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"order"}]},{"type":"text","text":" of calls across multiple mocks."}],"kind":"section","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Assert-call-counts","role":"pseudoSymbol","url":"\/tutorials\/swiftmocking\/verifying-interactions#Assert-call-counts","title":"Assert call counts","type":"section"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing":{"estimatedTime":"10min","role":"project","abstract":[{"type":"text","text":"Fixed return values only go so far. Real dependencies "},{"type":"emphasis","inlineContent":[{"type":"text","text":"compute"}]},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}],"kind":"project","type":"topic","title":"Stub Dynamically","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing","url":"\/tutorials\/swiftmocking\/dynamic-stubbing"},"03-3-1-sync-engine.swift":{"fileName":"SyncEngine.swift","highlights":[],"content":["import SwiftMocking","","@Mockable","protocol SyncEngine {","    func refresh(id: String) -> Void","}"],"syntax":"swift","fileType":"swift","identifier":"03-3-1-sync-engine.swift","type":"file"},"03-2-3-ordering.swift":{"type":"file","fileName":"CalculatorTests.swift","identifier":"03-2-3-ordering.swift","fileType":"swift","highlights":[{"line":11},{"line":12},{"line":13},{"line":14}],"content":["@Test","func stubOrdering() {","    let mock = MockCalculator()","","    let odd = ArgMatcher<Int>.any(that: { $0 % 2 == 1 })","","    \/\/ Specific matchers first...","    when(mock.calculate(a: odd, b: odd)).thenReturn { a, b in a * b }","    \/\/ ...broadest fallback last.","    when(mock.calculate(a: .any, b: .any)).thenReturn { a, b in a + b }","","    #expect(mock.calculate(a: 3 == b: 3), 9, \"both odd — multiplied\")",