latorTests.swift","content":["@Test","func stubOrdering() {","    let mock = MockCalculator()","","    let odd = ArgMatcher<Int>.any(that: { $0 % 2 == 1 })"],"highlights":[],"fileType":"swift","syntax":"swift","type":"file"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol":{"title":"Mock Your First Protocol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol","kind":"project","url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol","role":"project","estimatedTime":"10min","type":"topic","abstract":[{"text":"In this tutorial you’ll test a ","type":"text"},{"code":"Store","type":"codeVoice"},{"text":" that depends on a ","type":"text"},{"code":"PricingService","type":"codeVoice"},{"text":" — without writing a mock class by hand. You’ll mark a protocol with ","type":"text"},{"code":"@Mockable","type":"codeVoice"},{"text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it.","type":"text"}]},"03-3-2-side-effects.swift":{"syntax":"swift","fileType":"swift","type":"file","fileName":"SyncEngineTests.swift","content":["import Foundation","","\/\/ `.do` handlers are @Sendable, so record into a small thread-safe","\/\/ box rather than capturing a mutable `var`.","final class Recorder: @unchecked Sendable {","    private let lock = NSLock()","    private var storage: [String] = []","","    var values: [String] { lock.withLock { storage } }","","    func append(_ value: String) {","        lock.withLock { storage.append(value) }","    }","}"],"identifier":"03-3-2-side-effects.swift","highlights":[]},"intro-dynamic.png":{"variants":[{"url":"\/images\/SwiftMocking\/intro-dynamic.png","traits":["1x","light"]}],"type":"image","identifier":"intro-dynamic.png","alt":"A mock method call branching into a spy notebook recording its arguments."},"doc://SwiftMocking/tutorials/Table-Of-Contents/Getting-Started":{"title":"Getting Started","abstract":[],"kind":"articl