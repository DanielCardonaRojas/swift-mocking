{"identifier":{"url":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol","interfaceLanguage":"swift"},"kind":"project","hierarchy":{"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","modules":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Getting-Started","projects":[{"sections":[{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Mark-a-protocol-as-mockable"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Create-the-system-under-test"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Stub-return-values-with-when"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Verify-the-interaction"},{"kind":"assessment","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Check-Your-Understanding"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol"}]},{"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Argument-Matching","projects":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments","sections":[{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-any-or-exactly-one"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-with-predicates-and-ranges"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Capture-and-inspect-arguments"},{"kind":"assessment","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Check-Your-Understanding"}]}]},{"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Advanced-Stubbing-and-Verification","projects":[{"sections":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Return-computed-values","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Order-your-stubs","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Run-side-effects-with-do","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Drive-callback-based-APIs","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Check-Your-Understanding","kind":"assessment"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing"},{"sections":[{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Assert-call-counts"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-order-across-mocks"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Debug-failing-verifications"},{"kind":"assessment","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Check-Your-Understanding"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions"}]}],"paths":[["doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/$volume","doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Getting-Started"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/swiftmocking\/mocking-your-first-protocol"]}],"sections":[{"chapter":"Getting Started","kind":"hero","title":"Mock Your First Protocol","estimatedTimeInMinutes":10,"backgroundImage":"intro-first-mock.png","image":"intro-first-mock.png","content":[{"inlineContent":[{"type":"text","text":"In this tutorial you’ll test a "},{"type":"codeVoice","code":"Store"},{"text":" that depends on a ","type":"text"},{"code":"PricingService","type":"codeVoice"},{"text":" — without writing a mock class by hand. You’ll mark a protocol with ","type":"text"},{"code":"@Mockable","type":"codeVoice"},{"text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Along the way you’ll meet the two verbs that power every SwiftMocking test: "},{"inlineContent":[{"type":"text","text":"when"}],"type":"strong"},{"type":"text","text":" to arrange behavior, and "},{"type":"strong","inlineContent":[{"text":"verify","type":"text"}]},{"type":"text","text":" to assert it happened."}],"type":"paragraph"}]},{"kind":"tasks","tasks":[{"title":"Mark a protocol as mockable","stepsSection":[{"caption":[],"media":null,"code":"01-1-1-pricing-service.swift","type":"step","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Consider a store that needs prices. Pricing rules live behind a protocol so tests never depend on real pricing logic. Create ","type":"text"},{"code":"PricingService.swift","type":"codeVoice"},{"type":"text","text":" with the protocol:"}]}]},{"type":"step","runtimePreview":null,"caption":[],"content":[{"type":"paragraph","inlineContent":[{"text":"Now make it mockable: import ","type":"text"},{"code":"SwiftMocking","type":"codeVoice"},{"text":" and annotate the protocol with ","type":"text"},{"type":"codeVoice","code":"@Mockable"},{"text":":","type":"text"}]}],"media":null,"code":"01-1-2-pricing-service.swift"},{"code":"01-1-3-generated-mock.swift","runtimePreview":null,"type":"step","media":null,"content":[{"inlineContent":[{"type":"text","text":"That single annotation is all the macro needs. It generates "},{"type":"codeVoice","code":"MockPricingService"},{"type":"text","text":" next to your protocol — the equivalent of writing this by hand:"}],"type":"paragraph"}],"caption":[]},{"runtimePreview":null,"type":"step","code":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Notice the generated class carries "},{"inlineContent":[{"text":"two overloads","type":"text"}],"type":"strong"},{"text":" of ","type":"text"},{"type":"codeVoice","code":"price(for:)"},{"type":"text","text":". The "},{"code":"ArgMatcher<String>","type":"codeVoice"},{"type":"text","text":" version returns an "},{"code":"Interaction","type":"codeVoice"},{"type":"text","text":" — calling it, as in "},{"code":"mock.price(for: .any)","type":"codeVoice"},{"text":", ","type":"text"},{"inlineContent":[{"text":"describes","type":"text"}],"type":"emphasis"},{"text":" a call for stubbing or verification and never runs your code. The plain ","type":"text"},{"type":"codeVoice","code":"String"},{"text":" version is the real protocol requirement: calling it records the invocation and returns the stubbed value. That duality is the whole trick — the same syntax describes a call and performs it.","type":"text"}]}],"caption":[],"media":null}],"contentSection":[{"media":"chapter-getting-started.png","mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every mock starts life as a plain protocol describing a dependency. The "},{"type":"codeVoice","code":"@Mockable"},{"text":" macro expands that protocol into a ready-to-use mock class at compile time, so the protocol remains your single source of truth — when it changes, the mock changes with it.","type":"text"}]}]}],"anchor":"Mark-a-protocol-as-mockable"},{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With the mock generated, build the class you actually want to test. "},{"type":"codeVoice","code":"Store"},{"type":"text","text":" takes any "},{"code":"PricingService","type":"codeVoice"},{"type":"text","text":" — in production a real implementation, in tests the mock."}]}],"media":"intro-first-mock.png","kind":"contentAndMedia","mediaPosition":"trailing"}],"stepsSection":[{"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create "},{"code":"Store.swift","type":"codeVoice"},{"text":". The store registers items and asks the pricing service for each item’s price:","type":"text"}]}],"caption":[],"type":"step","runtimePreview":null,"code":"01-2-1-store.swift"}],"anchor":"Create-the-system-under-test","title":"Create the system under test"},{"contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"An unstubbed method can’t answer on its own. ","type":"text"},{"type":"codeVoice","code":"when"},{"type":"text","text":" arranges behavior: you describe the call with a matcher — here the literal "},{"code":"\"apple\"","type":"codeVoice"},{"text":" — and declare what it returns.","type":"text"}]}],"media":"chapter-getting-started.png"}],"stepsSection":[{"code":"01-3-1-store-tests.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create "},{"type":"codeVoice","code":"StoreTests.swift"},{"type":"text","text":", instantiate the mock, and stub a price for each item you’ll register. Then drive the store and assert the stubbed prices flowed through:"}]}],"media":null,"caption":[],"type":"step"},{"content":[{"inlineContent":[{"type":"text","text":"Run the test. The store called "},{"type":"codeVoice","code":"price(for:)"},{"type":"text","text":" twice — once per registered item — and each call was answered by the matching stub. No real pricing logic was ever involved."}],"type":"paragraph"}],"code":null,"runtimePreview":null,"type":"step","caption":[],"media":null}],"anchor":"Stub-return-values-with-when","title":"Stub return values with when"},{"title":"Verify the interaction","stepsSection":[{"runtimePreview":null,"caption":[],"type":"step","content":[{"inlineContent":[{"text":"Add a verification to the test. The ","type":"text"},{"code":".any","type":"codeVoice"},{"text":" matcher matches every call regardless of the item, and ","type":"text"},{"type":"codeVoice","code":".called(2)"},{"type":"text","text":" asserts exactly two invocations:"}],"type":"paragraph"}],"media":null,"code":"01-4-1-store-tests.swift"},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You’ve completed the full mocking loop: "},{"inlineContent":[{"type":"text","text":"generate"}],"type":"strong"},{"type":"text","text":" with "},{"code":"@Mockable","type":"codeVoice"},{"type":"text","text":", "},{"inlineContent":[{"type":"text","text":"arrange"}],"type":"strong"},{"text":" with ","type":"text"},{"code":"when","type":"codeVoice"},{"text":", ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"act"}]},{"type":"text","text":" on your type, "},{"type":"strong","inlineContent":[{"type":"text","text":"assert"}]},{"text":" with ","type":"text"},{"type":"codeVoice","code":"verify"},{"text":".","type":"text"}]}],"media":null,"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Run the test again — it still passes, and now it also fails loudly if the store ever stops consulting the pricing service."}],"type":"paragraph"}],"code":null}],"contentSection":[{"kind":"contentAndMedia","media":"intro-verifying.png","content":[{"type":"paragraph","inlineContent":[{"text":"Asserting output is half the story; interaction tests also assert ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"that a dependency was used, and how","type":"text"}]},{"type":"text","text":". "},{"type":"codeVoice","code":"verify"},{"type":"text","text":" takes the same call description as "},{"code":"when","type":"codeVoice"},{"type":"text","text":" and asserts how often it happened."}]}],"mediaPosition":"trailing"}],"anchor":"Verify-the-interaction"}]},{"assessments":[{"title":[{"inlineContent":[{"text":"What does applying ","type":"text"},{"type":"codeVoice","code":"@Mockable"},{"type":"text","text":" to a protocol do?"}],"type":"paragraph"}],"choices":[{"isCorrect":false,"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The mock is a separate class, and nothing is attached to the protocol itself."}]}],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It adds default implementations to the protocol via an extension."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"It generates a "},{"code":"Mock","type":"codeVoice"},{"type":"text","text":"-subclassing class that conforms to the protocol, with one overload for describing calls and one for performing them."}],"type":"paragraph"}],"isCorrect":true,"justification":[{"inlineContent":[{"type":"text","text":"The generated class has an "},{"type":"codeVoice","code":"ArgMatcher"},{"type":"text","text":" overload returning an "},{"code":"Interaction","type":"codeVoice"},{"text":", plus the real protocol requirement that records invocations and returns stubs.","type":"text"}],"type":"paragraph"}]},{"justification":[{"inlineContent":[{"type":"text","text":"Everything here happens at compile time — there’s no runtime registry."}],"type":"paragraph"}],"isCorrect":false,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It registers the protocol with a runtime mock factory that creates mocks on demand."}]}]}],"content":[],"type":"multiple-choice"},{"title":[{"inlineContent":[{"type":"text","text":"Which pair of functions arranges a stub and then asserts it was used?"}],"type":"paragraph"}],"choices":[{"isCorrect":false,"justification":[{"inlineContent":[{"type":"text","text":"Close vocabulary, but not the names SwiftMocking uses."}],"type":"paragraph"}],"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"stub"},{"type":"text","text":" and "},{"type":"codeVoice","code":"assert"}]}]},{"isCorrect":false,"justification":[{"type":"paragraph","inlineContent":[{"type":"text","text":"That’s MockK’s vocabulary. SwiftMocking borrows from Mockito instead."}]}],"content":[{"type":"paragraph","inlineContent":[{"code":"given","type":"codeVoice"},{"type":"text","text":" and "},{"code":"check","type":"codeVoice"}]}]},{"isCorrect":true,"justification":[{"type":"paragraph","inlineContent":[{"code":"when(mock.price(for: \"apple\")).thenReturn(13)","type":"codeVoice"},{"text":" arranges; ","type":"text"},{"code":"verify(mock.price(for: .any)).called(2)","type":"codeVoice"},{"text":" asserts.","type":"text"}]}],"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"when"},{"type":"text","text":" and "},{"code":"verify","type":"codeVoice"}]}]}],"content":[],"type":"multiple-choice"}],"anchor":"Check-Your-Understanding","kind":"assessments"},{"abstract":[{"type":"text","text":"Stubbing "},{"code":"\"apple\"","type":"codeVoice"},{"type":"text","text":" and verifying "},{"code":".any","type":"codeVoice"},{"type":"text","text":" is just the beginning. Real tests need finer control: "},{"inlineContent":[{"text":"any","type":"text"}],"type":"emphasis"},{"type":"text","text":" amount, amounts "},{"type":"emphasis","inlineContent":[{"type":"text","text":"under"}]},{"type":"text","text":" 100, codes "},{"inlineContent":[{"type":"text","text":"in"}],"type":"emphasis"},{"text":" a range, collections ","type":"text"},{"inlineContent":[{"type":"text","text":"of a certain size"}],"type":"emphasis"},{"text":" — or some predicate only you can express.","type":"text"}],"title":"Match Arguments Precisely","action":{"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments","type":"reference","isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}]},"featuredEyebrow":"Tutorial","kind":"callToAction"}],"metadata":{"categoryPathComponent":"Table-Of-Contents","role":"project","category":"SwiftMocking","title":"Mock Your First Protocol"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Assert-call-counts":{"url":"\/tutorials\/swiftmocking\/verifying-interactions#Assert-call-counts","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Assert-call-counts","kind":"section","type":"section","title":"Assert call counts","role":"pseudoSymbol","abstract":[{"type":"text","text":"You’ve verified counts and matched arguments. This page completes the toolkit: asserting a call happened "},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"text":", proving a mock was ","type":"text"},{"inlineContent":[{"type":"text","text":"untouched"}],"type":"emphasis"},{"text":", and — the signature feature — verifying the ","type":"text"},{"inlineContent":[{"text":"order","type":"text"}],"type":"emphasis"},{"text":" of calls as they happened across multiple mocks.","type":"text"}]},"intro-first-mock.png":{"type":"image","alt":"A Store box receiving a PricingService dependency from above.","variants":[{"url":"\/images\/SwiftMocking\/intro-first-mock.png","traits":["1x","light"]}],"identifier":"intro-first-mock.png"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing":{"title":"Stub Dynamically","estimatedTime":"10min","abstract":[{"type":"text","text":"Fixed return values only go so far. Real dependencies "},{"type":"emphasis","inlineContent":[{"text":"compute","type":"text"}]},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}],"role":"project","kind":"project","type":"topic","url":"\/tutorials\/swiftmocking\/dynamic-stubbing","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol#Mark-a-protocol-as-mockable":{"title":"Mark a protocol as mockable","abstract":[{"type":"text","text":"In this tutorial you’ll test a "},{"type":"codeVoice","code":"Store"},{"type":"text","text":" that depends on a "},{"type":"codeVoice","code":"PricingService"},{"type":"text","text":" — without writing a mock class by hand. You’ll mark a protocol with "},{"type":"codeVoice","code":"@Mockable"},{"type":"text","text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it."}],"role":"pseudoSymbol","kind":"section","type":"section","url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol#Mark-a-protocol-as-mockable","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Mark-a-protocol-as-mockable"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Order-your-stubs":{"role":"pseudoSymbol","url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Order-your-stubs","abstract":[{"type":"text","text":"Fixed return values only go so far. Real dependencies "},{"type":"emphasis","inlineContent":[{"type":"text","text":"compute"}]},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}],"title":"Order your stubs","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Order-your-stubs","type":"section","kind":"section"},"01-1-1-pricing-service.swift":{"content":["protocol PricingService {","    func price(for item: String) -> Int","}"],"syntax":"swift","fileName":"PricingService.swift","identifier":"01-1-1-pricing-service.swift","type":"file","highlights":[],"fileType":"swift"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Verify-order-across-mocks":{"role":"pseudoSymbol","url":"\/tutorials\/swiftmocking\/verifying-interactions#Verify-order-across-mocks","abstract":[{"text":"You’ve verified counts and matched arguments. This page completes the toolkit: asserting a call happened ","type":"text"},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"text":", proving a mock was ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"untouched","type":"text"}]},{"text":", and — the signature feature — verifying the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"order","type":"text"}]},{"type":"text","text":" of calls as they happened across multiple mocks."}],"title":"Verify order across mocks","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-order-across-mocks","type":"section","kind":"section"},"doc://SwiftMocking/tutorials/SwiftMocking/matching-arguments#Match-with-predicates-and-ranges":{"role":"pseudoSymbol","url":"\/tutorials\/swiftmocking\/matching-arguments#Match-with-predicates-and-ranges","abstract":[{"type":"text","text":"Stubbing "},{"code":"\"apple\"","type":"codeVoice"},{"type":"text","text":" and verifying "},{"code":".any","type":"codeVoice"},{"type":"text","text":" is just the beginning. Real tests need finer control: "},{"inlineContent":[{"text":"any","type":"text"}],"type":"emphasis"},{"type":"text","text":" amount, amounts "},{"inlineContent":[{"text":"under","type":"text"}],"type":"emphasis"},{"type":"text","text":" 100, codes "},{"inlineContent":[{"type":"text","text":"in"}],"type":"emphasis"},{"type":"text","text":" a range, collections "},{"inlineContent":[{"text":"of a certain size","type":"text"}],"type":"emphasis"},{"type":"text","text":" — or some predicate only you can express."}],"title":"Match with predicates and ranges","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-with-predicates-and-ranges","type":"section","kind":"section"},"doc://SwiftMocking/tutorials/Table-Of-Contents/Getting-Started":{"url":"\/tutorials\/table-of-contents\/getting-started","kind":"article","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Getting-Started","type":"topic","title":"Getting Started","role":"article","abstract":[]},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Return-computed-values":{"url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Return-computed-values","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Return-computed-values","role":"pseudoSymbol","abstract":[{"text":"Fixed return values only go so far. Real dependencies ","type":"text"},{"inlineContent":[{"text":"compute","type":"text"}],"type":"emphasis"},{"text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks.","type":"text"}],"title":"Return computed values","kind":"section","type":"section"},"01-2-1-store.swift":{"syntax":"swift","content":["class Store {","    var items: [String] = []","    var prices: [String: Int] = [:]","    let pricingService: any PricingService","","    init(pricingService: any PricingService) {","        self.pricingService = pricingService","    }","","    func register(_ item: String) {","        items.append(item)","        prices[item] = pricingService.price(for: item)","    }","}"],"fileName":"Store.swift","identifier":"01-2-1-store.swift","type":"file","highlights":[],"fileType":"swift"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Check-Your-Understanding":{"url":"\/tutorials\/swiftmocking\/verifying-interactions#Check-Your-Understanding","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Check-Your-Understanding","title":"Check Your Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Run-side-effects-with-do":{"url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Run-side-effects-with-do","kind":"section","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Run-side-effects-with-do","type":"section","title":"Run side effects with do","role":"pseudoSymbol","abstract":[{"text":"Fixed return values only go so far. Real dependencies ","type":"text"},{"inlineContent":[{"text":"compute","type":"text"}],"type":"emphasis"},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}]},"doc://SwiftMocking/tutorials/Table-Of-Contents/Argument-Matching":{"role":"article","url":"\/tutorials\/table-of-contents\/argument-matching","abstract":[],"title":"Argument Matching","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Argument-Matching","type":"topic","kind":"article"},"doc://SwiftMocking/tutorials/SwiftMocking/matching-arguments#Match-any-or-exactly-one":{"url":"\/tutorials\/swiftmocking\/matching-arguments#Match-any-or-exactly-one","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-any-or-exactly-one","role":"pseudoSymbol","abstract":[{"type":"text","text":"Stubbing "},{"code":"\"apple\"","type":"codeVoice"},{"type":"text","text":" and verifying "},{"code":".any","type":"codeVoice"},{"type":"text","text":" is just the beginning. Real tests need finer control: "},{"type":"emphasis","inlineContent":[{"text":"any","type":"text"}]},{"type":"text","text":" amount, amounts "},{"type":"emphasis","inlineContent":[{"type":"text","text":"under"}]},{"type":"text","text":" 100, codes "},{"type":"emphasis","inlineContent":[{"type":"text","text":"in"}]},{"type":"text","text":" a range, collections "},{"type":"emphasis","inlineContent":[{"type":"text","text":"of a certain size"}]},{"type":"text","text":" — or some predicate only you can express."}],"title":"Match any — or exactly one","kind":"section","type":"section"},"01-3-1-store-tests.swift":{"highlights":[],"content":["import SwiftMocking","import XCTest","","final class StoreTests: XCTestCase {","    func testRegisterUsesStubbedPrices() {","        let mock = MockPricingService()","        let store = Store(pricingService: mock)","","        when(mock.price(for: \"apple\")).thenReturn(13)","        when(mock.price(for: \"banana\")).thenReturn(17)","","        store.register(\"apple\")","        store.register(\"banana\")","","        XCTAssertEqual(store.prices[\"apple\"], 13)","        XCTAssertEqual(store.prices[\"banana\"], 17)","    }","}"],"fileType":"swift","syntax":"swift","ide