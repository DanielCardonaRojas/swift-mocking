tent":[{"identifier":"doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/Spy","isActive":true,"type":"reference"},{"text":" is only ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" when both its inputs ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" its output are, because it","type":"text"},{"text":" ","type":"text"},{"text":"stores stubbed outputs. Registering an action touches none of that — it is pure","type":"text"},{"text":" ","type":"text"},{"text":"bookkeeping over the invocation matcher — so waiting for a call should not require a","type":"text"},{"text":" ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" return type.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This protocol exposes exactly that bookkeeping. Its members traffic only in an opaque","type":"text"},{"text":" ","type":"text"},{"text":"action token and a label — never in an ","type":"text"},{"type":"codeVoice","code":"Input"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"Output"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"value"}]},{"text":" — so","type":"text"},{"text":" ","type":"text"},{"code":"until(_:timeout:)","type":"codeVoice"},{"text":" can capture a ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" handle to a spy that is not itself","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":".","type":"text"}]},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/Spy"},{"type":"text","text":" does not conform directly; "},{"type":"codeVoice","code":"Spy\/actionRegistrar"},{"type":"text","text":" vends a small non-generic"},{"type":"text","text":" "},{"type":"text","text":"class that does. Conforming "},{"type":"codeVoice","code":"Spy"},{"type":"text","text":" itself would require it to be "},{"inlineContent":[{"type":"text","text":"unconditionally"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" at this package’s Swift 6.0 floor, which is exactly the conditional"},{"type":"text","text":" "},{"type":"text","text":"conformance this indirection exists to preserve."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Every member must stay free of "},{"type":"codeVoice","code":"Input"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Output"},{"type":"text","text":" values. Adding one"},{"type":"text","text":" "},{"type":"text","text":"that exposes either would make the conformance unsound."}],"type":"paragraph"}],"name":"Important","type":"aside","style":"important"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftMocking\/documentation\/SwiftMocking"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://SwiftMocking/documentation/SwiftMocking":{"identifier":"doc:\/\/SwiftMocking\/documentation\/SwiftMocking","type":"topic","title":"SwiftMocking","role":"collection","url":"\/documentation\/swiftmocking","abstract":[{"text":"Type-safe mocking for Swift, powered by macros.","type":"text"}],"kind":"symbol"},"doc://SwiftMocking/s8SendableP":{"identifier":"doc:\/\/SwiftMocking\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://SwiftMocking/documentation/SwiftMocking/SpyActionRegistering":{"title":"SpyActionRegistering","navigatorTitle":[{"text":"SpyActionRegistering","kind":"identifier"}],"abstract":[{"text":"The action machinery of a spy, erased over its ","type":"text"},{"type":"codeVoice","code":"Output"},{"text":".","type":"text"}],"identifier":"doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/SpyActionRegistering","kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/swiftmocking\/spyactionregistering","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpyActionRegistering","kind":"identifier"}]},"doc://SwiftMocki