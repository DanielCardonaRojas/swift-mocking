{"abstract":[{"text":"A matcher that matches any argument where a specific property of the argument is equal to a given value.","type":"text"}],"variants":[{"paths":["\/documentation\/swiftmocking\/argmatcher\/any(where:equals:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"any"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Property"},{"kind":"text","text":">("},{"kind":"externalParam","text":"where"},{"kind":"text","text":" "},{"kind":"internalParam","text":"keyPath"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s7KeyPathC","text":"KeyPath"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Argument"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Property"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"equals"},{"kind":"text","text":" "},{"kind":"internalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Property"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/ArgMatcher","preciseIdentifier":"s:12SwiftMocking10ArgMatcherV","text":"ArgMatcher"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Argument"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Argument"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Property"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SQ","text":"Equatable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Property"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"KeyPath"},{"type":"text","text":" to the property of the "},{"type":"codeVoice","code":"Argument"},{"type":"text","text":" type that should be compared."}]}],"name":"keyPath"},{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" value to compare the property against.","type":"text"}],"type":"paragraph"}],"name":"value"}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"code":"ArgMatcher","type":"codeVoice"},{"type":"text","text":" that matches arguments where the specified property equals the given value."}]}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"text":"This is useful for matching arguments based on a nested property, especially when the argument itself","type":"text"},{"text":" ","type":"text"},{"text":"might not be ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" or when you only care about a specific part of it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Example:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct User {","    let id: String","    let name: String","}","","protocol UserService {","    func getUser(user: User) -> User?","}","","\/\/ Stub the getUser method to return a user when the id property of the argument is \"123\"","when(mockUserService.getUser(user: .any(where: \\.id, equals: \"123\"))).thenReturn(User(id: \"123\", name: \"Test User\"))","","\/\/ Verify that getUser was called with a user whose name property is \"Alice\"","verify(mockUserService.getUser(user: .any(where: \\.name, equals: \"Alice\"))).called()"]},{"inlineContent":[{"text":"Prefer this over ","type":"text"},{"code":".any(that:)","type":"codeVoice"},{"text":" when you’re comparing a property to a value: it","type":"text"},{"text":" ","type":"text"},{"text":"captures the value rather than a caller-supplied closure, so it never produces a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"“non-Sendable function value” warning under Swift 6 concurrency checking."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftMocking\/documentation\/SwiftMocking","doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/ArgMatcher"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/ArgMatcher\/any(where:equals:)"},"metadata":{"symbolKind":"method","externalID":"s:12SwiftMocking10ArgMatcherV3any5where6equalsACyxGs7KeyPathCyxqd__G_qd__ts8SendableRzSQRd__sAKRd__lFZ","modules":[{"name":"SwiftMocking"}],"roleHeading":"Type Method","title":"any(where:equals:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"any"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Property"},{"kind":"text","text":">("},{"kind":"externalParam","text":"where"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"KeyPath","preciseIdentifier":"s:s7KeyPathC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Argument"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Property"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"equals"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Property"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"ArgMatcher","preciseIdentifier":"s:12SwiftMocking10ArgMatcherV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Argument"