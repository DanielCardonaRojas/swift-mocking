oc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Capture-and-inspect-arguments"},{"kind":"assessment","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Check-Your-Understanding"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments"}]},{"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Advanced-Stubbing-and-Verification","projects":[{"sections":[{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Return-computed-values"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Order-your-stubs"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Run-side-effects-with-do","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Drive-callback-based-APIs","kind":"task"},{"kind":"assessment","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Check-Your-Understanding"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions","sections":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Assert-call-counts","kind":"task"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-order-across-mocks"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Debug-failing-verifications","kind":"task"},{"kind":"assessment","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Check-Your-Understanding"}]}]}]},"sections":[{"chapter":"Advanced Stubbing and Verification","kind":"hero","title":"Verify Every Interaction","estimatedTimeInMinutes":10,"backgroundImage":"intro-verifying.png","image":"intro-verifying.png","content":[{"inlineContent":[{"type":"text","text":"You’ve verified counts and matched arguments. This page completes the toolkit: asserting a call happened "},{"type":"emphasis","inlineContent":[{"text":"never","type":"text"}]},{"type":"text","text":", proving a mock was "},{"inlineContent":[{"type":"text","text":"untouched"}],"type":"emphasis"},{"text":", and — the signature feature — verifying the ","type":"text"},{"inlineContent":[{"type":"text","text":"order"}],"type":"emphasis"},{"text":" of calls as they happened across multiple mocks.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You’ll also learn to read failure output and turn on invocation logging when a test goes sideways.","type":"text"}],"type":"paragraph"}]},{"kind":"tasks","tasks":[{"anchor":"Assert-call-counts","contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"code":"verify(...).called(n)","type":"codeVoice"},{"type":"text","text":" asserts an "},{"inlineContent":[{"type":"text","text":"exact"}],"type":"emphasis"},{"text":" count, and ","type":"text"},{"code":"called()","type":"codeVoice"},{"type":"text","text":" with no argument asserts exactly once. For the negative space there’s "},{"type":"codeVoice","code":"neverCalled()"},{"text":" on an interaction and ","type":"text"},{"type":"codeVoice","code":"verifyZeroInteractions(_:)"},{"text":" for an entire mock.","type":"text"}]}],"mediaPosition":"trailing","media":"intro-verifying.png"}],"stepsSection":[{"caption":[],"media":null,"code":"04-1-1-counts.swift","runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Drive a pricing mock and pin down every corner: two total calls, one specific, one never-made, and a second mock entirely untouched:","type":"text"}]}]},{"caption":[],"media":null,"code":null,"runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Count matchers compose too — "},{"type":"codeVoice","code":".called(.greaterThan(1))"},{"type":"text","text":" or "},{"type":"codeVoice","code":".called(.in(1...3))"},{"type":"text","text":" accept any "},{"type":"codeVoice","code":"ArgMatcher<Int>"},{"type":"text","text":", just like value matchers."}],"type":"paragraph"}]}],"title":"Assert call counts"},{"stepsSection":[{"type":"step","media":null,"caption":[],"code":"04-2-1-in-order.swift","content":[{"inlineContent":[{"text":"Declare a second dependency for analytics, then interleave calls to both mocks from your system:","type":"text"}],"type":"paragraph"}],"runtimePreview":null},{"type":"step","media":null,"caption":[],"code":"04-2-2-in-order-verify.swift","content":[{"inlineContent":[{"text":"Wrap the expected sequence in ","type":"text"},{"type":"codeVoice","code":"verifyInOrder"},{"text":" — each entry is the same call description you’d pass to ","type":"text"},{"type":"codeVoice","code":"verify"},{"text":":","type":"text"}],"type":"paragraph"}],"runtimePreview":null},{"code":null,"runtimePreview":null,"caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The assertion passes only if matching invocations exist on each spy "},{"type":"emphasis","inlineContent":[{"type":"text","text":"in the written order"}]},{"type":"text","text":" — other calls may interleave freely; only the relative order of the listed interactions is checked."}]}],"type":"step","media":null}],"title":"Verify order across mocks","contentSection":[{"media":"chapter-advanced.png","mediaPosition":"trailing","content":[{"inlineContent":[{"type":"text","text":"Some bugs are pure ordering: log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"after"}]},{"type":"text","text":" charging, refresh "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" reading. "},{"type":"codeVoice","code":"verifyInOrder"},{"type":"text","text":" asserts a whole sequence — and because it works across spies, the sequence can span multiple mocks."}],"type":"paragraph"}],"kind":"contentAndMedia"}],"anchor":"Verify-order-across-mocks"},{"stepsSection":[{"code":"04-3-1-failing.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Flip any expected count to a wrong number and the test reports the actual count in place, at the failing line:","type":"text"}]}],"runtimePreview":null,"media":null,"type":"step","caption":[]},{"code":"04-3-2-logging.swift","runtimePreview":null,"media":null,"caption":[],"content":[{"inlineContent":[{"type":"text","text":"Enable logging on a mock instance and every subsequent invocation prints to the console — invaluable when you can’t tell which arguments your production code is really passing:"}],"type":"paragraph"}],"type":"step"}],"contentSection":[{"media":"intro-verifying.png","mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"A failed count check reports exactly what actually happened — for example, expecting 4 calls and getting ","type":"text"},{"code":"Unfulfilled call count. Actual: 2","type":"codeVoice"},{"text":". When counts don’t add up, two tools close the gap: ","type":"text"},{"type":"codeVoice","code":"captured"},{"type":"text","text":" to see the real arguments, and invocation logging to watch calls arrive."}]}]}],"title":"Debug failing verifications","anchor":"Debug-failing-verifications"}]},{"assessments":[{"choices":[{"justification":[{"inlineContent":[{"type":"text","text":"That’s the behavior of some frameworks, but here the default is stricter."}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"The method was called at least once."}],"type":"paragraph"}],"isCorrect":false},{"justification":[{"inlineContent":[{"type":"codeVoice","code":"called()"},{"type":"text","text":" defaults to "},{"type":"codeVoice","code":".equal(1)"},{"type":"text","text":". For looser bounds pass a count matcher, like "},{"type":"codeVoice","code":".called(.greaterThan(0))"},{"type":"text","text":"."}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"The method was called exactly once."}],"type":"paragraph"}],"isCorrect":true},{"content":[{"inlineContent":[{"text":"The method was called at most once.","type":"text"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"text":"Zero calls would fail too — it’s an exact assertion.","type":"text"}],"type":"paragraph"}],"isCorrect":false}],"content":[],"type":"multiple-choice","title":[{"inlineContent":[{"type":"text","text":"What does "},{"type":"codeVoice","code":"verify(mock.price(for: .any)).called()"},{"type":"text","text":" assert, with no argument?"}],"type":"paragraph"}]},{"choices":[{"justification":[{"inlineContent":[{"text":"Separate assertions prove each call happened, but say nothing about their order.","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"Three separate "},{"code":"verify(...).called()","type":"codeVoice"},{"text":" assertions.","type":"text"}],"type":"paragraph"}],"isCorrect":false},{"justification":[{"inlineContent":[{"type":"codeVoice","code":"verifyInOrder"},{"text":" checks the listed interactions occurred in the written sequence, even across different mocks.","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"A single ","type":"text"},{"type":"codeVoice","code":"verifyInOrder"},{"text":" listing all three interactions.","type":"text"}],"type":"paragraph"}],"isCorrect":true},{"justification":[{"type":"paragraph","inlineContent":[{"text":"That asserts the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"absence","type":"text"}]},{"text":" of all interactions — the opposite of what you need.","type":"text"}]}],"isCorrect":false,"content":[{"type":"paragraph","inlineContent":[{"code":"verifyZeroInteractions","type":"codeVoice"},{"text":" on the analytics mock.","type":"text"}]}]}],"content":[],"type":"multiple-choice","title":[{"inlineContent":[{"type":"text","text":"Your checkout test needs to prove the analytics event fired "},{"type":"emphasis","inlineContent":[{"type":"text","text":"between"}]},{"type":"text","text":" the two pricing calls. Which tool asserts that?"}],"type":"paragraph"}]}],"kind":"assessments","anchor":"Check-Your-Understanding"}],"references":{"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Check-Your-Understanding":{"titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Check-Your-Understanding","type":"link","title":"Check Your Understanding","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Check-Your-Understanding"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Assert-call-counts":{"url":"\/tutorials\/swiftmocking\/verifying-interactions#Assert-call-counts","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Assert-call-counts","kind":"section","type":"section","title":"Assert call counts","role":"pseudoSymbol","abstract":[{"type":"text","text":"You’ve verified counts and matched arguments. This page completes the toolkit: asserting a call happened "},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"text":", proving a mock was ","type":"text"},{"inlineContent":[{"type":"text","text":"untouched"}],"type":"emphasis"},{"text":", and — the signature feature — verifying the ","type":"text"},{"inlineContent":[{"text":"order","type":"text"}],"type":"emphasis"},{"text":" of calls as they happened across multiple mocks.","type":"text"}]},"04-3-1-failing.swift":{"syntax":"swift","content":["func testExpectedCountMessage() {","    let mock = MockPricingService()","","    when(mock.price(for: .any)).thenReturn(13)","    _ = mock.price(for: \"apple\")","    _ = mock.price(for: \"banana\")","","    \/\/ Fails at this line with:","    \/\/   Unfulfilled call count. Actual: 2","    verify(mock.price(for: .any)).called(4)","}"],"fileName":"CallCountTests.swift","identifier":"04-3-1-failing.swift","type":"file","highlights":[],"fileType":"swift"},"04-1-1-counts.swift":{"fileName":"CallCountTests.swift","type":"file","identifier":"04-1-1-counts.swift","content":["func testCounts() {","    let mock = MockPricingService()","","    when(mock.price(for: .any)).thenReturn(13)","    _ = mock.price(for: \"apple\")","    _ = mock.price(for: \"banana\")","","    verify(mock.price(for: .any)).called(2)      \/\/ exactly twice","    verify(mock.price(for: \"apple\")).called()    \/\/ exactly once (default)","    verify(mock.price(for: \"cherry\")).neverCalled()","","    let untouched = MockPricingService()","    verifyZeroInteractions(untouched)            \/\/ no calls of any kind","}"],"fileType":"swift","highlights":[],"syntax":"swift"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing":{"title":"Stub Dynamically","estimatedTime":"10min","abstract":[{"type":"text","text":"Fixed return values only go so far. Real dependencies "},{"type":"emphasis","inlineContent":[{"text":"compute","type":"text"}]},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}],"role":"project","kind":"project","type":"topic","url":"\/tutorials\/swiftmocking\/dynamic-stubbing","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol#Mark-a-protocol-as-mockable":{"title":"Mark a protocol as mockable","abstract":[{"type":"text","text":"In this tutorial you’ll test a "},{"type":"codeVoice","code":"Store"},{"type":"text","text":" that depends on a "},{"type":"codeVoice","code":"PricingService"},{"type":"text","text":" — without writing a mock class by hand. You’ll mark a protocol with "},{"type":"codeVoice","code":"@Mockable"},{"type":"text","text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it."}],"role":"pseudoSymbol","kind":"section","type":"section","url":"\/tutorials\/