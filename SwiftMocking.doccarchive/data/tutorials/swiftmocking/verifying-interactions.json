xt","text":"You’ve verified counts and matched arguments. This page completes the toolkit: asserting a call happened "},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"type":"text","text":", proving a mock was "},{"inlineContent":[{"type":"text","text":"untouched"}],"type":"emphasis"},{"type":"text","text":", and — the signature feature — verifying the "},{"inlineContent":[{"type":"text","text":"order"}],"type":"emphasis"},{"type":"text","text":" of calls as they happened across multiple mocks."}],"role":"pseudoSymbol","kind":"section","type":"section","url":"\/tutorials\/swiftmocking\/verifying-interactions#Debug-failing-verifications","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Debug-failing-verifications"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol#Verify-the-interaction":{"type":"section","kind":"section","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Verify-the-interaction","title":"Verify the interaction","url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol#Verify-the-interaction","abstract":[{"text":"In this tutorial you’ll test a ","type":"text"},{"code":"Store","type":"codeVoice"},{"text":" that depends on a ","type":"text"},{"code":"PricingService","type":"codeVoice"},{"text":" — without writing a mock class by hand. You’ll mark a protocol with ","type":"text"},{"code":"@Mockable","type":"codeVoice"},{"text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it.","type":"text"}],"role":"pseudoSymbol"},"doc://SwiftMocking/tutorials/Table-Of-Contents/Advanced-Stubbing-and-Verification":{"type":"topic","kind":"article","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Advanced-Stubbing-and-Verification","title":"Advanced Stubbing and Verification","url":"\/tutorials\/table-of-contents\/advanced-stubbing-and-verification","abstract":[],"role":"article"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol#Check-Your-Understanding":{"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Check-Your-Understanding","type":"link","url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol#Check-Your-Understanding","title":"Check Your Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}]},"doc://SwiftMocking/tutorials/SwiftMocking/matching-arguments":{"url":"\/tutorials\/swiftmocking\/matching-arguments","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments","type":"topic","title":"Match Arguments Precisely","role":"project","abstract":[{"type":"text","text":"Stubbing "},{"type":"codeVoice","code":"\"apple\""},{"type":"text","text":" and verifying "},{"type":"codeVoice","code":".any"},{"type":"text","text":" is just the beginning. Real tests need finer control: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"any"}]},{"text":" amount, amounts ","type":"text"},{"inlineContent":[{"type":"text","text":"under"}],"type":"emphasis"},{"type":"text","text":" 100, codes "},{"inlineContent":[{"text":"in","type":"text"}],"type":"emphasis"},{"text":" a range, collections ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"of a certain size"}]},{"type":"text","text":" — or some predicate only you can express."}]},"04-2-2-in-order-verify.swift":{"type":"file","fileName":"CheckoutTests.swift","identifier":"04-2-2-in-order-verify.swift","content":["import SwiftMocking","import XCTest","","@Mockable","protocol AnalyticsService {","    func logEvent(_ name: String) -> Void","}","","final class CheckoutTests: XCTestCase {","    func testCheckoutOrder() {","        let pricing = MockPricingService()","        let analytics = MockAnalyticsService()","","        when(pricing.price(for: .any)).thenReturn(13)","","        \/\/ The system under test interleaves both dependencies.","        _ = pricing.price(for: \"apple\")","        analytics.logEvent(\"purchase\")","        _ = pricing.price(for: \"banana\")","","        \/\/ Passes only because the calls above happened in this order.","        verifyInOrder {","            pricing.price(for: \"apple\")","            analytics.logEvent(\"purchase\")","            pricing.price(for: \"banana\")","        }","    }","}"],"fileType":"swift","highlights":[{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26}],"syntax":"swift"},"04-3-2-logging.swift":{"highlights":[],"content":["func testInvocationLogging() {","    let mock = MockPricingService()","    mock.isLoggingEnabled = true","","    \/\/ Console: each invocation is printed as it happens.","    _ = mock.price(for: \"apple\")","    _ = mock.price(for: \"banana\")","}"],"fileType":"swift","syntax":"swift","identifier":"04-3-2-logging.swift","type":"file","fileName":"LoggingTests.swift"}}}