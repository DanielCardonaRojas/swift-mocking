eginning. Real tests need finer control: "},{"type":"emphasis","inlineContent":[{"text":"any","type":"text"}]},{"type":"text","text":" amount, amounts "},{"type":"emphasis","inlineContent":[{"type":"text","text":"under"}]},{"type":"text","text":" 100, codes "},{"type":"emphasis","inlineContent":[{"type":"text","text":"in"}]},{"type":"text","text":" a range, collections "},{"type":"emphasis","inlineContent":[{"type":"text","text":"of a certain size"}]},{"type":"text","text":" — or some predicate only you can express."}],"title":"Match any — or exactly one","kind":"section","type":"section"},"doc://SwiftMocking/tutorials/SwiftMocking/matching-arguments#Capture-and-inspect-arguments":{"url":"\/tutorials\/swiftmocking\/matching-arguments#Capture-and-inspect-arguments","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Capture-and-inspect-arguments","kind":"section","type":"section","title":"Capture and inspect arguments","role":"pseudoSymbol","abstract":[{"text":"Stubbing ","type":"text"},{"type":"codeVoice","code":"\"apple\""},{"type":"text","text":" and verifying "},{"type":"codeVoice","code":".any"},{"type":"text","text":" is just the beginning. Real tests need finer control: "},{"type":"emphasis","inlineContent":[{"text":"any","type":"text"}]},{"text":" amount, amounts ","type":"text"},{"inlineContent":[{"text":"under","type":"text"}],"type":"emphasis"},{"text":" 100, codes ","type":"text"},{"inlineContent":[{"text":"in","type":"text"}],"type":"emphasis"},{"type":"text","text":" a range, collections "},{"inlineContent":[{"text":"of a certain size","type":"text"}],"type":"emphasis"},{"type":"text","text":" — or some predicate only you can express."}]},"04-2-1-in-order.swift":{"type":"file","fileType":"swift","fileName":"CheckoutTests.swift","identifier":"04-2-1-in-order.swift","content":["import SwiftMocking","import XCTest","","@Mockable","protocol AnalyticsService {","    func logEvent(_ name: String) -> Void","}","","final class CheckoutTests: XCTestCase {","    func testCheckoutOrder() {","        let pricing = MockPricingService()","        let analytics = MockAnalyticsService()","","        when(pricing.price(for: .any)).thenReturn(13)","","        \/\/ The system under test interleaves both dependencies.","        _ = pricing.price(for: \"apple\")","        analytics.logEvent(\"purchase\")","        _ = pricing.price(for: \"banana\")","    }","}"],"syntax":"swift","highlights":[]},"doc://SwiftMocking/tutorials/Table-Of-Contents":{"url":"\/tutorials\/table-of-contents","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","kind":"overview","type":"topic","title":"Meet SwiftMocking","role":"overview","abstract":[{"text":"Stop hand-writing mock classes. With SwiftMocking, one ","type":"text"},{"type":"codeVoice","code":"@Mockable"},{"text":" annotation turns any protocol into a fully featured mock: stub return values, match arguments with expressive matchers, drive callbacks, and verify every interaction — all type-safe, all local, no code generation steps in your build.","type":"text"}]},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Drive-callback-based-APIs":{"type":"section","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Drive-callback-based-APIs","role":"pseudoSymbol","abstract":[{"type":"text","text":"Fixed return values only go so far. Real dependencies "},{"inlineContent":[{"text":"compute","type":"text"}],"type":"emphasis"},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}],"title":"Drive callback-based APIs","kind":"section","url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Drive-callback-based-APIs"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol":{"url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking