{"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/tutorials\/swiftmocking\/matching-arguments"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"project","sections":[{"estimatedTimeInMinutes":10,"kind":"hero","backgroundImage":"intro-matching.png","chapter":"Argument Matching","title":"Match Arguments Precisely","content":[{"type":"paragraph","inlineContent":[{"text":"Stubbing ","type":"text"},{"code":"\"apple\"","type":"codeVoice"},{"text":" and verifying ","type":"text"},{"code":".any","type":"codeVoice"},{"text":" is just the beginning. Real tests need finer control: ","type":"text"},{"inlineContent":[{"text":"any","type":"text"}],"type":"emphasis"},{"text":" amount, amounts ","type":"text"},{"inlineContent":[{"type":"text","text":"under"}],"type":"emphasis"},{"text":" 100, codes ","type":"text"},{"inlineContent":[{"type":"text","text":"in"}],"type":"emphasis"},{"type":"text","text":" a range, collections "},{"inlineContent":[{"text":"of a certain size","type":"text"}],"type":"emphasis"},{"text":" — or some predicate only you can express.","type":"text"}]},{"inlineContent":[{"text":"In this tutorial you’ll drive an ","type":"text"},{"code":"OrderService","type":"codeVoice"},{"type":"text","text":" through the full matcher vocabulary, then reach the arguments your code actually passed with "},{"code":"captured","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"image":"intro-matching.png"},{"tasks":[{"anchor":"Match-any-or-exactly-one","stepsSection":[{"type":"step","caption":[],"content":[{"inlineContent":[{"type":"text","text":"Create "},{"type":"codeVoice","code":"OrderService.swift"},{"type":"text","text":" with a protocol that prices orders in cents and validates item lists:"}],"type":"paragraph"}],"runtimePreview":null,"media":null,"code":"02-1-1-order-service.swift"},{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Start a test with just the mock in place, so you can watch the matchers accumulate one at a time."}]}],"type":"step","caption":[],"code":"02-1-2-any-and-exact.swift","media":null},{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Register the broad stub first. "},{"code":".any","type":"codeVoice"},{"text":" matches every ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":", so at this point every amount you ask about returns ","type":"text"},{"code":"100","type":"codeVoice"},{"text":".","type":"text"}]}],"type":"step","caption":[],"code":"02-1-3-any-and-exact.swift","media":null},{"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Now layer a specific stub on top. "},{"code":"999","type":"codeVoice"},{"text":" narrows to ","type":"text"},{"type":"codeVoice","code":".equal(999)"},{"type":"text","text":", and because it’s the more specific matcher it wins for that amount — while "},{"type":"codeVoice","code":"199"},{"text":" still falls through to ","type":"text"},{"code":".any","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"step","caption":[],"code":"02-1-4-any-and-exact.swift","media":null},{"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The same literal sugar works in verifications: "},{"code":"verify(mock.discount(forAmountCents: 199))","type":"codeVoice"},{"text":" counts only the calls that passed ","type":"text"},{"code":"199","type":"codeVoice"},{"text":".","type":"text"}]}],"code":"02-1-5-any-and-exact.swift","runtimePreview":null,"type":"step","caption":[]},{"content":[{"inlineContent":[{"type":"text","text":"Optional arguments have their own matchers — "},{"type":"codeVoice","code":".notNil()"},{"type":"text","text":" and "},{"type":"codeVoice","code":".nil()"},{"type":"text","text":" — and they read naturally in both directions: "},{"type":"codeVoice","code":"when(mock.validate(items: .any, coupon: .nil())).thenReturn(true)"},{"type":"text","text":" stubs only coupon-less validations, while "},{"type":"codeVoice","code":"verify(mock.validate(items: .any, coupon: .notNil())).called(1)"},{"type":"text","text":" counts the rest."}],"type":"paragraph"}],"code":null,"runtimePreview":null,"caption":[],"media":null,"type":"step"}],"title":"Match any — or exactly one","contentSection":[{"mediaPosition":"trailing","content":[{"inlineContent":[{"text":"Every argument position in a ","type":"text"},{"code":"when","type":"codeVoice"},{"type":"text","text":" or "},{"code":"verify","type":"codeVoice"},{"type":"text","text":" call takes an "},{"type":"codeVoice","code":"ArgMatcher"},{"text":". Two extremes cover most cases: ","type":"text"},{"type":"codeVoice","code":".any"},{"text":" matches everything, while ","type":"text"},{"type":"codeVoice","code":".equal"},{"text":" — or a plain literal, thanks to literal conformances — matches one exact value.","type":"text"}],"type":"paragraph"}],"kind":"contentAndMedia","media":"chapter-matching.png"}]},{"anchor":"Match-with-predicates-and-ranges","title":"Match with predicates and ranges","contentSection":[{"media":"chapter-matching.png","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the boundary matters more than the value, reach for comparison and range matchers. They mirror Swift’s own vocabulary: "},{"code":".lessThan","type":"codeVoice"},{"type":"text","text":", "},{"code":".greaterThan","type":"codeVoice"},{"type":"text","text":", "},{"code":".in(...)","type":"codeVoice"},{"type":"text","text":" with any range expression, and "},{"code":".hasCount(in:)","type":"codeVoice"},{"type":"text","text":" for collections."}]}],"mediaPosition":"trailing"}],"stepsSection":[{"type":"step","code":"02-2-1-predicates-and-ranges.swift","runtimePreview":null,"media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Add a second test to the same class, starting from a fresh mock.","type":"text"}]}],"caption":[]},{"type":"step","code":"02-2-2-predicates-and-ranges.swift","runtimePreview":null,"media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Build a discount ladder out of three non-overlapping bands. ","type":"text"},{"type":"codeVoice","code":".lessThan"},{"type":"text","text":", "},{"type":"codeVoice","code":".in(_:)"},{"type":"text","text":" with a closed range, and "},{"type":"codeVoice","code":".greaterThan"},{"type":"text","text":" between them cover every possible amount exactly once."}]}],"caption":[]},{"type":"step","code":"02-2-3-predicates-and-ranges.swift","runtimePreview":null,"media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Probe one amount per band to prove each boundary routes where you expect."}]}],"caption":[]},{"media":null,"code":"02-2-4-predicates-and-ranges.swift","runtimePreview":null,"caption":[],"content":[{"inlineContent":[{"text":"For everything else there’s ","type":"text"},{"code":".any(that:)","type":"codeVoice"},{"text":": your closure becomes the matcher, and it receives the real argument — an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":", not ","type":"text"},{"code":"Any","type":"codeVoice"},{"text":" — so it type-checks like ordinary Swift. Here it counts round amounts: of the three calls above only ","type":"text"},{"code":"500","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"5000","type":"codeVoice"},{"text":" are multiples of 100, so the assertion expects exactly two. ","type":"text"},{"code":".hasCount(in:)","type":"codeVoice"},{"text":" applies the same idea to a collection’s length.","type":"text"}],"type":"paragraph"}],"type":"step"}]},{"anchor":"Capture-and-inspect-arguments","contentSection":[{"kind":"contentAndMedia","media":"intro-matching.png","content":[{"inlineContent":[{"text":"Matchers assert; sometimes you want to ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"examine"}]},{"text":". ","type":"text"},{"type":"codeVoice","code":"captured"},{"text":" replays each matching invocation through a closure, handing you the concrete arguments your production code passed — perfect for invariants that don’t reduce to a single equality check.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing"}],"stepsSection":[{"code":"02-3-1-captured.swift","runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Record two validations that differ in both arguments — one with a coupon, one without. A permissive "},{"type":"codeVoice","code":".any"},{"text":" stub lets both calls through so there’s something to inspect.","type":"text"}]}],"caption":[],"type":"step","media":null},{"code":"02-3-2-captured.swift","runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"Narrow the capture to the coupon-bearing call, then assert against the concrete arguments. "},{"type":"codeVoice","code":"items"},{"type":"text","text":" arrives as a real "},{"type":"codeVoice","code":"[String]"},{"type":"text","text":" and "},{"code":"coupon","type":"codeVoice"},{"text":" as a ","type":"text"},{"code":"String?","type":"codeVoice"},{"text":" — no casting, and the compiler checks your assertions.","type":"text"}],"type":"paragraph"}],"caption":[],"type":"step","media":null},{"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Close the closure and the test. Filter and inspect compose freely: the matcher selects the invocations, "},{"type":"codeVoice","code":"captured"},{"type":"text","text":" shows you them. If no invocation matches, the verification reports a failed call count instead of silently skipping your assertions."}]}],"type":"step","code":"02-3-3-captured.swift","caption":[],"media":null}],"title":"Capture and inspect arguments"}],"kind":"tasks"},{"abstract":[{"text":"Fixed return values only go so far. Real dependencies ","type":"text"},{"inlineContent":[{"text":"compute","type":"text"}],"type":"emphasis"},{"text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks.","type":"text"}],"action":{"overridingTitle":"Get started","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing","type":"reference"},"title":"Stub Dynamically","featuredEyebrow":"Tutorial","kind":"callToAction"}],"hierarchy":{"paths":[["doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/$volume","doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Argument-Matching"]],"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","modules":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Getting-Started","projects":[{"sections":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Mark-a-protocol-as-mockable","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Create-the-system-under-test","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Stub-return-values-with-when","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Verify-the-interaction","kind":"task"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol"}]},{"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Argument-Matching","projects":[{"sections":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-any-or-exactly-one","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-with-predicates-and-ranges","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Capture-and-inspect-arguments","kind":"task"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments"}]},{"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Advanced-Stubbing-and-Verification","projects":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing","sections":[{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Return-computed-values"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Order-your-stubs"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Run-side-effects-with-do"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Drive-callback-based-APIs"}]},{"sections":[{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Assert-call-counts"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-order-across-mocks"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-thrown-errors"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Wait-for-calls-that-havent-happened-yet","kind":"task"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-property-reads-and-writes"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Debug-failing-verifications","kind":"task"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions"}]},{"projects":[{"sections":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Control-what-unstubbed-requirements-return","kind":"task"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Mock-static-requirements-safely"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Use-the-rest-of-Swift-Testings-vocabulary","kind":"task"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Swift-Testing-Integration"}]},"metadata":{"category":"SwiftMocking","title":"Match Arguments Precisely","categoryPathComponent":"Table-Of-Contents","role":"project"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments"},"references":{"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Debug-failing-verifications":{"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Debug-failing-verifications","kind":"section","title":"Debug failing verifications","url":"\/tutorials\/swiftmocking\/verifying-interactions#Debug-failing-verifications","role":"pseudoSymbol","type":"section","abstract":[{"text":"You’ve verified counts and matched arguments. This page completes the toolkit: counting calls with the full matcher vocabulary, asserting a call happened ","type":"text"},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"text":", proving a mock was ","type":"text"},{"inlineContent":[{"type":"text","text":"untouched"}],"type":"emphasis"},{"text":", verifying thrown errors, waiting for calls that arrive from another task, distinguishing property reads from writes, and — the signature feature — verifying the ","type":"text"},{"inlineContent":[{"text":"order","type":"text"}],"type":"emphasis"},{"text":" of calls across multiple mocks.","type":"text"}]},"02-1-4-any-and-exact.swift":{"highlights":[{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17}],"fileName":"OrderServiceTests.swift","content":["import SwiftMocking","import Testing","","@Suite","struct OrderServiceTests {","    @Test","    func anyVersusExact() {","        let mock = MockOrderService()","","        \/\/ The fallback: answers every call, whatever the amount.","        when(mock.discount(forAmountCents: .any)).thenReturn(100)","","        \/\/ More specific: wins for this exact amount.","        when(mock.discount(forAmountCents: 999)).thenReturn(200)","","        #expect(mock.discount(forAmountCents: 999) == 200)","        #expect(mock.discount(forAmountCents: 199) == 100)"],"syntax":"swift","identifier":"02-1-4-any-and-exact.swift","type":"file","fileType":"swift"},"doc://SwiftMocking/tutorials/Table-Of-Contents/Argument-Matching":{"role":"article","abstract":[],"kind":"article","type":"topic","title":"Argument Matching","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Argument-Matching","url":"\/tutorials\/table-of-contents\/argument-matching"},"02-2-1-predicates-and-ranges.swift":{"fileType":"swift","content":["@Test","func predicatesAndRanges() {","    let mock = MockOrderService()"],"type":"file","identifier":"02-2-1-predicates-and-ranges.swift","highlights":[],"fileName":"OrderServiceTests.swift","syntax":"swift"},"doc://SwiftMocking/tutorials/Table-Of-Contents":{"title":"Meet SwiftMocking","kind":"overview","abstract":[{"type":"text","text":"Stop hand-writing mock classes. With SwiftMocking, one "},{"code":"@Mockable","type":"codeVoice"},{"text":" annotation turns any protocol into a fully featured mock: stub return values, match arguments with expressive matchers, drive callbacks, and verify every interaction — all type-safe, all local, no code generation steps in your build.","type":"text"}],"url":"\/tutorials\/table-of-contents","role":"overview","type":"topic","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Verify-order-across-mocks":{"abstract":[{"text":"You’ve verified counts and matched arguments. This page completes the toolkit: counting calls with the full matcher vocabulary, asserting a call happened ","type":"text"},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"text":", proving a mock was ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"untouched","type":"text"}]},{"text":", verifying thrown errors, waiting for calls that arrive from another task, distinguishing property reads from writes, and — the signature feature — verifying the ","type":"text"},{"inlineContent":[{"text":"order","type":"text"}],"type":"emphasis"},{"type":"text","text":" of calls across multiple mocks."}],"kind":"section","title":"Verify order across mocks","url":"\/tutorials\/swiftmocking\/verifying-interactions#Verify-order-across-mocks","role":"pseudoSymbol","type":"section","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-order-across-mocks"},"doc://SwiftMocking/tutorials/SwiftMocking/matching-arguments":{"kind":"project","abstract":[{"type":"text","text":"Stubbing "},{"type":"codeVoice","code":"\"apple\""},{"text":" and verifying ","type":"text"},{"type":"codeVoice","code":".any"},{"type":"text","text":" is just the beginning. Real tests need finer control: "},{"inlineContent":[{"text":"any","type":"text"}],"type":"emphasis"},{"text":" amount, amounts ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"under"}]},{"text":" 100, codes ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"in","type":"text"}]},{"text":" a range, collections ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"of a certain size"}]},{"type":"text","text":" — or some predicate only you can express."}],"type":"topic","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments","title":"Match Arguments Precisely","estimatedTime":"10min","url":"\/tutorials\/swiftmocking\/matching-arguments","role":"project"},"02-3-2-captured.swift":{"syntax":"swift","fileName":"OrderServiceTests.swift","content":["@Test","func capturedArguments() {","    let mock = MockOrderService()","","    when(mock.validate(items: .any, coupon: .any)).thenReturn(true)","    _ = mock.validate(items: [\"apple\", \"banana\"], coupon: \"SUMMER\")","    _ = mock.validate(items: [\"cherry\"], coupon: nil)","","    \/\/ The matcher selects invocations; captured replays each one","    \/\/ with its concrete, fully typed arguments.","    verify(mock.validate(items: .any, coupon: .equal(\"SUMMER\")))","        .captured { items, coupon in","            #expect(items == [\"apple\", \"banana\"])"],"highlights":[{"line":8},{"line":9},{"line":10},{"line":11},{"line":12},{"line":13}],"type":"file","fileType":"swift","identifier":"02-3-2-captured.swift"},"02-3-1-captured.swift":{"content":["@Test","func capturedArguments() {","    let mock = MockOrderService()","","    when(mock.validate(items: .any, coupon: .any)).thenReturn(true)","    _ = mock.validate(items: [\"apple\", \"banana\"], coupon: \"SUMMER\")","    _ = mock.validate(items: [\"cherry\"], coupon: nil)"],"highlights":[],"identifier":"02-3-1-captured.swift","fileName":"OrderServiceTests.swift","syntax":"swift","type":"file","fileType":"swift"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Return-computed-values":{"kind":"section","abstract":[{"type":"text","text":"Fixed return values only go so far. Real dependencies "},{"type":"emphasis","inlineContent":[{"type":"text","text":"compute"}]},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}],"type":"section","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Return-computed-values","title":"Return computed values","url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Return-computed-values","role":"pseudoSymbol"},"02-2-4-predicates-and-ranges.swift":{"fileName":"OrderServiceTests.swift","highlights":[{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19}],"content":["@Test","func predicatesAndRanges() {","    let mock = MockOrderService()","","    when(mock.discount(forAmountCents: .lessThan(100))).thenReturn(0)","    when(mock.discount(forAmountCents: .in(100...999))).thenReturn(50)","    when(mock.discount(forAmountCents: .greaterThan(999))).thenReturn(150)","","    #expect(mock.discount(forAmountCents: 50) == 0)","    #expect(mock.discount(forAmountCents: 500) == 50)","    #expect(mock.discount(forAmountCents: 5000) == 150)","","    \/\/ Any predicate you can express as a closure becomes a matcher.","    let roundAmounts = ArgMatcher<Int>.any(that: { $0.isMultiple(of: 100) })","    verify(mock.discount(forAmountCents: roundAmounts)).called(2)","","    \/\/ Collections match by count: at most three items.","    verify(mock.validate(items: .hasCount(in: ...3), coupon: .any)).neverCalled()","}"],"syntax":"swift","fileType":"swift","identifier":"02-2-4-predicates-and-ranges.swift","type":"file"},"doc://SwiftMocking/tutorials/SwiftMocking/testing-integration":{"kind":"project","type":"topic","abstract":[{"text":"Every test so far has been an ordinary ","type":"text"},{"code":"@Test","type":"codeVoice"},{"text":". This page covers what Swift Testing adds on top: ","type":"text"},{"inlineContent":[{"text":"traits","type":"text"}],"type":"strong"},{"text":", which scope behavior to a test or a whole suite.","type":"text"}],"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration","role":"project","estimatedTime":"15min","url":"\/tutorials\/swiftmocking\/testing-integration","title":"Swift Testing, Defaults, and Statics"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Verify-property-reads-and-writes":{"kind":"section","type":"section","abstract":[{"text":"You’ve verified counts and matched arguments. This page completes the toolkit: counting calls with the full matcher vocabulary, asserting a call happened ","type":"text"},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"text":", proving a mock was ","type":"text"},{"inlineContent":[{"text":"untouched","type":"text"}],"type":"emphasis"},{"text":", verifying thrown errors, waiting for calls that arrive from another task, distinguishing property reads from writes, and — the signature feature — verifying the ","type":"text"},{"inlineContent":[{"text":"order","type":"text"}],"type":"emphasis"},{"text":" of calls across multiple mocks.","type":"text"}],"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-property-reads-and-writes","role":"pseudoSymbol","title":"Verify property reads and writes","url":"\/tutorials\/swiftmocking\/verifying-interactions#Verify-property-reads-and-writes"},"chapter-matching.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/SwiftMocking\/chapter-matching.png"}],"identifier":"chapter-matching.png","type":"image","alt":"A number line with three shaded ranges labeled less than, in, and greater than."},"doc://SwiftMocking/tutorials/SwiftMocking/testing-integration#Control-what-unstubbed-requirements-return":{"kind":"section","type":"section","abstract":[{"text":"Every test so far has been an ordinary ","type":"text"},{"code":"@Test","type":"codeVoice"},{"text":". This page covers what Swift Testing adds on top: ","type":"text"},{"inlineContent":[{"type":"text","text":"traits"}],"type":"strong"},{"text":", which scope behavior to a test or a whole suite.","type":"text"}],"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Control-what-unstubbed-requirements-return","role":"pseudoSymbol","url":"\/tutorials\/swiftmocking\/testing-integration#Control-what-unstubbed-requirements-return","title":"Control what unstubbed requirements return"},"02-1-3-any-and-exact.swift":{"highlights":[{"line":9},{"line":10},{"line":11}],"fileName":"OrderServiceTests.swift","content":["import SwiftMocking","import Testing","","@Suite","struct OrderServiceTests {","    @Test","    func anyVersusExact() {","        let mock = MockOrderService()","","        \/\/ The fallback: answers every call, whatever the amount.","        when(mock.discount(forAmountCents: .any)).thenReturn(100)"],"type":"file","identifier":"02-1-3-any-and-exact.swift","syntax":"swift","fileType":"swift"},"02-1-5-any-and-exact.swift":{"fileType":"swift","type":"file","content":["import SwiftMocking","import Testing","","@Suite","struct OrderServiceTests {","    @Test","    func anyVersusExact() {","        let mock = MockOrderService()","","        \/\/ The fallback: answers every call, whatever the amount.","        when(mock.discount(forAmountCents: .any)).thenReturn(100)","","        \/\/ More specific: wins for this exact amount.","        when(mock.discount(forAmountCents: 999)).thenReturn(200)","","        #expect(mock.discount(forAmountCents: 999) == 200)","        #expect(mock.discount(forAmountCents: 199) == 100)","","        \/\/ The literal 199 behaves as .equal(199) in verifications too.","        verify(mock.discount(forAmountCents: 199)).called()","    }","}"],"identifier":"02-1-5-any-and-exact.swift","highlights":[{"line":18},{"line":19},{"line":20},{"line":21},{"line":22}],"fileName":"OrderServiceTests.swift","syntax":"swift"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Drive-callback-based-APIs":{"kind":"section","abstract":[{"type":"text","text":"Fixed return values only go so far. Real dependencies "},{"type":"emphasis","inlineContent":[{"type":"text","text":"compute"}]},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}],"type":"section","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Drive-callback-based-APIs","title":"Drive callback-based APIs","url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Drive-callback-based-APIs","role":"pseudoSymbol"},"02-1-2-any-and-exact.swift":{"highlights":[],"fileName":"OrderServiceTests.swift","content":["import SwiftMocking","import Testing","","@Suite","struct OrderServiceTests {","    @Test","    func anyVersusExact() {","        let mock = MockOrderService()"],"syntax":"swift","identifier":"02-1-2-any-and-exac