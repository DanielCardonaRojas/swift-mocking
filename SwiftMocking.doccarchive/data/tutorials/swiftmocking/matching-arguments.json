{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"title":"Match Arguments Precisely","category":"SwiftMocking","role":"project","categoryPathComponent":"Table-Of-Contents"},"kind":"project","identifier":{"url":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/$volume","doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Argument-Matching"]],"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","modules":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Getting-Started","projects":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol","sections":[{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Mark-a-protocol-as-mockable"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Create-the-system-under-test"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Stub-return-values-with-when"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Verify-the-interaction"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Check-Your-Understanding","kind":"assessment"}]}]},{"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Argument-Matching","projects":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments","sections":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-any-or-exactly-one","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-with-predicates-and-ranges","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Capture-and-inspect-arguments","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Check-Your-Understanding","kind":"assessment"}]}]},{"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Advanced-Stubbing-and-Verification","projects":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing","sections":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Return-computed-values","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Order-your-stubs","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Run-side-effects-with-do","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Drive-callback-based-APIs","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Check-Your-Understanding","kind":"assessment"}]},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions","sections":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Assert-call-counts","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-order-across-mocks","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Debug-failing-verifications","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Check-Your-Understanding","kind":"assessment"}]}]}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/swiftmocking\/matching-arguments"]}],"sections":[{"estimatedTimeInMinutes":10,"content":[{"type":"paragraph","inlineContent":[{"text":"Stubbing ","type":"text"},{"code":"\"apple\"","type":"codeVoice"},{"text":" and verifying ","type":"text"},{"type":"codeVoice","code":".any"},{"text":" is just the beginning. Real tests need finer control: ","type":"text"},{"inlineContent":[{"type":"text","text":"any"}],"type":"emphasis"},{"text":" amount, amounts ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"under","type":"text"}]},{"type":"text","text":" 100, codes "},{"type":"emphasis","inlineContent":[{"text":"in","type":"text"}]},{"text":" a range, collections ","type":"text"},{"inlineContent":[{"text":"of a certain size","type":"text"}],"type":"emphasis"},{"type":"text","text":" — or some predicate only you can express."}]},{"type":"paragraph","inlineContent":[{"text":"In this tutorial you’ll drive an ","type":"text"},{"code":"OrderService","type":"codeVoice"},{"text":" through the full matcher vocabulary, then reach the arguments your code actually passed with ","type":"text"},{"code":"captured","type":"codeVoice"},{"type":"text","text":"."}]}],"chapter":"Argument Matching","backgroundImage":"intro-matching.png","title":"Match Arguments Precisely","kind":"hero","image":"intro-matching.png"},{"kind":"tasks","tasks":[{"anchor":"Match-any-or-exactly-one","contentSection":[{"mediaPosition":"trailing","media":"chapter-matching.png","kind":"contentAndMedia","content":[{"inlineContent":[{"type":"text","text":"Every argument position in a "},{"type":"codeVoice","code":"when"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"verify"},{"type":"text","text":" call takes an "},{"type":"codeVoice","code":"ArgMatcher"},{"text":". Two extremes cover most cases: ","type":"text"},{"type":"codeVoice","code":".any"},{"type":"text","text":" matches everything, while "},{"code":".equal","type":"codeVoice"},{"type":"text","text":" — or a plain literal, thanks to literal conformances — matches one exact value."}],"type":"paragraph"}]}],"title":"Match any — or exactly one","stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Create ","type":"text"},{"code":"OrderService.swift","type":"codeVoice"},{"type":"text","text":" with a protocol that prices orders in cents and validates item lists:"}]}],"media":null,"type":"step","runtimePreview":null,"code":"02-1-1-order-service.swift","caption":[]},{"media":null,"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In a test, stub the broad case with "},{"code":".any","type":"codeVoice"},{"type":"text","text":", then add a more specific stub for one exact amount. Specific matchers win; everything else falls through to "},{"type":"codeVoice","code":".any"},{"text":":","type":"text"}]}],"caption":[],"code":"02-1-2-any-and-exact.swift"},{"type":"step","content":[{"inlineContent":[{"text":"Optional arguments have their own matchers — ","type":"text"},{"code":".notNil()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".nil()","type":"codeVoice"},{"type":"text","text":" — and they read naturally in both directions: "},{"code":"when(mock.validate(items: .any, coupon: .nil())).thenReturn(true)","type":"codeVoice"},{"type":"text","text":" stubs only coupon-less validations, while "},{"code":"verify(mock.validate(items: .any, coupon: .notNil())).called(1)","type":"codeVoice"},{"type":"text","text":" counts the rest."}],"type":"paragraph"}],"runtimePreview":null,"media":null,"caption":[],"code":null}]},{"stepsSection":[{"code":"02-2-1-predicates-and-ranges.swift","runtimePreview":null,"media":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Stub a discount ladder using comparisons and ranges, then check each band behaves as configured:","type":"text"}]}],"caption":[]},{"code":null,"runtimePreview":null,"media":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For everything else there’s "},{"type":"codeVoice","code":".any(that:)"},{"type":"text","text":": your closure becomes the matcher, and it receives the real argument — an "},{"type":"codeVoice","code":"Int"},{"type":"text","text":", not "},{"type":"codeVoice","code":"Any"},{"type":"text","text":" — so it type-checks like ordinary Swift. The listing above uses it to count round amounts: only "},{"code":"500","type":"codeVoice"},{"type":"text","text":" and "},{"code":"5000","type":"codeVoice"},{"type":"text","text":" are multiples of 100, so the assertion expects exactly two calls."}]}],"caption":[]}],"contentSection":[{"kind":"contentAndMedia","media":"chapter-matching.png","content":[{"type":"paragraph","inlineContent":[{"text":"When the boundary matters more than the value, reach for comparison and range matchers. They mirror Swift’s own vocabulary: ","type":"text"},{"type":"codeVoice","code":".lessThan"},{"text":", ","type":"text"},{"type":"codeVoice","code":".greaterThan"},{"text":", ","type":"text"},{"type":"codeVoice","code":".in(...)"},{"text":" with any range expression, and ","type":"text"},{"type":"codeVoice","code":".hasCount(in:)"},{"text":" for collections.","type":"text"}]}],"mediaPosition":"trailing"}],"anchor":"Match-with-predicates-and-ranges","title":"Match with predicates and ranges"},{"contentSection":[{"content":[{"inlineContent":[{"text":"Matchers assert; sometimes you want to ","type":"text"},{"inlineContent":[{"type":"text","text":"examine"}],"type":"emphasis"},{"text":". ","type":"text"},{"code":"captured","type":"codeVoice"},{"text":" replays each matching invocation through a closure, handing you the concrete arguments your production code passed — perfect for invariants that don’t reduce to a single equality check.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia","media":"intro-matching.png"}],"anchor":"Capture-and-inspect-arguments","stepsSection":[{"content":[{"inlineContent":[{"type":"text","text":"Record a few validations, then narrow the capture with matchers and inspect what survives. The closure runs once per matching call, with fully typed arguments:"}],"type":"paragraph"}],"media":null,"code":"02-3-1-captured.swift","runtimePreview":null,"type":"step","caption":[]},{"content":[{"inlineContent":[{"type":"text","text":"Filter and inspect compose freely: the matcher selects the invocations, "},{"code":"captured","type":"codeVoice"},{"type":"text","text":" shows you them. If no invocation matches, the verification reports a failed call count instead of silently skipping your assertions."}],"type":"paragraph"}],"type":"step","caption":[],"code":null,"media":null,"runtimePreview":null}],"title":"Capture and inspect arguments"}]},{"kind":"assessments","anchor":"Check-Your-Understanding","assessments":[{"title":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"when(mock.discount(forAmountCents: 199)).thenReturn(50)"},{"type":"text","text":" stubs which calls?"}]}],"type":"multiple-choice","content":[],"choices":[{"justification":[{"type":"paragraph","inlineContent":[{"code":"ArgMatcher","type":"codeVoice"},{"type":"text","text":" conforms to the integer-literal protocols, so a bare value is sugar for "},{"type":"codeVoice","code":".equal"},{"text":".","type":"text"}]}],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Exactly the calls passing "},{"type":"codeVoice","code":"199"},{"type":"text","text":" — the literal behaves as "},{"type":"codeVoice","code":".equal(199)"},{"type":"text","text":"."}]}],"isCorrect":true},{"isCorrect":false,"justification":[{"inlineContent":[{"type":"text","text":"Literals narrow to "},{"code":".equal","type":"codeVoice"},{"type":"text","text":", not broaden to "},{"type":"codeVoice","code":".any"},{"text":". Pass ","type":"text"},{"type":"codeVoice","code":".any"},{"type":"text","text":" explicitly for that."}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"Any call, because a bare value is treated like "},{"type":"codeVoice","code":".any"},{"type":"text","text":"."}],"type":"paragraph"}]},{"isCorrect":false,"justification":[{"inlineContent":[{"type":"text","text":"There’s no fuzzy matching — that’s what "},{"type":"codeVoice","code":".any(that:)"},{"type":"text","text":" or range matchers are for."}],"type":"paragraph"}],"content":[{"type":"paragraph","inlineContent":[{"text":"Calls with amounts within 100 of 199.","type":"text"}]}]}]},{"choices":[{"isCorrect":false,"content":[{"type":"paragraph","inlineContent":[{"code":".lessThan(101)","type":"codeVoice"}]}],"justification":[{"inlineContent":[{"type":"text","text":"Prefer the range form — it states the intent directly."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".in(0...100)","type":"codeVoice"}]}],"justification":[{"inlineContent":[{"code":".in","type":"codeVoice"},{"text":" accepts any Swift range expression — closed, partial, you name it.","type":"text"}],"type":"paragraph"}],"isCorrect":true},{"justification":[{"inlineContent":[{"type":"codeVoice","code":".hasCount"},{"type":"text","text":" matches collection "},{"type":"emphasis","inlineContent":[{"text":"lengths","type":"text"}]},{"type":"text","text":", not scalar values."}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"codeVoice","code":".hasCount(in: 0...100)"}],"type":"paragraph"}],"isCorrect":false}],"type":"multiple-choice","content":[],"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Which matcher accepts amounts from 0 through 100, inclusive?"}]}]}]},{"title":"Stub Dynamically","kind":"callToAction","action":{"type":"reference","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"overridingTitle":"Get started","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing","isActive":true},"abstract":[{"type":"text","text":"Fixed return values only go so far. Real dependencies "},{"type":"emphasis","inlineContent":[{"type":"text","text":"compute"}]},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}],"featuredEyebrow":"Tutorial"}],"references":{"doc://SwiftMocking/tutorials/Table-Of-Contents/Getting-Started":{"url":"\/tutorials\/table-of-contents\/getting-started","kind":"article","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Getting-Started","type":"topic","title":"Getting Started","role":"article","abstract":[]},"02-1-1-order-service.swift":{"fileName":"OrderService.swift","syntax":"swift","identifier":"02-1-1-order-service.swift","content":["import SwiftMocking","","@Mockable","protocol OrderService {","    func discount(forAmountCents amount: Int) -> Int","    func validate(items: [String], coupon code: String?) -> Bool","}"],"fileType":"swift","highlights":[],"type":"file"},"02-2-1-predicates-and-ranges.swift":{"highlights":[],"content":["func testPredicatesAndRanges() {","    let mock = MockOrderService()","","    when(mock.discount(forAmountCents: .lessThan(100))).thenReturn(0)","    when(mock.discount(forAmountCents: .in(100...999))).thenReturn(50)","    when(mock.discount(forAmountCents: .greaterThan(999))).thenReturn(150)","","    XCTAssertEqual(mock.discount(forAmountCents: 50), 0)","    XCTAssertEqual(mock.discount(forAmountCents: 500), 50)","    XCTAssertEqual(mock.discount(forAmountCents: 5000), 150)","","    \/\/ Any predicate you can express as a closure becomes a matcher.","    let roundAmounts = ArgMatcher<Int>.any(that: { $0.isMultiple(of: 100) })","    verify(mock.discount(forAmountCents: roundAmounts)).called(2)","","    \/\/ Collections match by count: at most three items.","    verify(mock.validate(items: .hasCount(in: ...3), coupon: .any)).neverCalled()","}"],"fileType":"swift","syntax":"swift","identifier":"02-2-1-predicates-and-ranges.swift","type":"file","fileName":"OrderServiceTests.swift"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Verify-order-across-mocks":{"role":"pseudoSymbol","url":"\/tutorials\/swiftmocking\/verifying-interactions#Verify-order-across-mocks","abstract":[{"text":"You’ve verified counts and matched arguments. This page completes the toolkit: asserting a call happened ","type":"text"},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"text":", proving a mock was ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"untouched","type":"text"}]},{"text":", and — the signature feature — verifying the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"order","type":"text"}]},{"type":"text","text":" of calls as they happened across multiple mocks."}],"title":"Verify order across mocks","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-order-across-mocks","type":"section","kind":"section"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Order-your-stubs":{"title":"Order your stubs","abstract":[{"type":"text","text":"Fixed return values only go so far. Real dependencies "},{"inlineContent":[{"text":"compute","type":"text"}],"type":"emphasis"},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}],"role":"pseudoSymbol","kind":"section","type":"section","url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Order-your-stubs","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Order-your-stubs"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Check-Your-Understanding":{"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Check-Your-Understanding","url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Check-Your-Understanding","type":"link","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"title":"Check Your Understanding"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Debug-failing-verifications":{"title":"Debug failing verifications","abstract":[{"type":"text","text":"You’ve verified counts and matched arguments. This page completes the toolkit: asserting a call happened "},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"type":"text","text":", proving a mock was "},{"inlineContent":[{"type":"text","text":"untouched"}],"type":"emphasis"},{"type":"text","text":", and — the signature feature — verifying the "},{"inlineContent":[{"type":"text","text":"order"}],"type":"emphasis"},{"type":"text","text":" of calls as they happened across multiple mocks."}],"role":"pseudoSymbol","kind":"section","type":"section","url":"\/tutorials\/swiftmocking\/verifying-interactions#Debug-failing-verifications","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Debug-failing-verifications"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol#Stub-return-values-with-when":{"url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol#Stub-return-values-with-when","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Stub-return-values-with-when","role":"pseudoSymbol","abstract":[{"type":"text","text":"In this tutorial you’ll test a "},{"type":"codeVoice","code":"Store"},{"type":"text","text":" that depends on a "},{"type":"codeVoice","code":"PricingService"},{"type":"text","text":" — without writing a mock class by hand. You’ll mark a protocol with "},{"type":"codeVoice","code":"@Mockable"},{"type":"text","text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it."}],"title":"Stub return values with when","kind":"section","type":"section"},"doc://SwiftMocking/tutorials/Table-Of-Contents/Argument-Matching":{"role":"article","url":"\/tutorials\/table-of-contents\/argument-matching","abstract":[],"title":"Argument Matching","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Argument-Matching","type":"topic","kind":"article"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol#Verify-the-interaction":{"type":"section","kind":"section","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Verify-the-interaction","title":"Verify the interaction","url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol#Verify-the-interaction","abstract":[{"text":"In this tutorial you’ll test a ","type":"text"},{"code":"Store","type":"codeVoice"},{"text":" that depends on a ","type":"text"},{"code":"PricingService","type":"codeVoice"},{"text":" — without writing a mock class by hand. You’ll mark a protocol with ","type":"text"},{"code":"@Mockable","type":"codeVoice"},{"text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it.","type":"text"}],"role":"pseudoSymbol"},"doc://SwiftMocking/tutorials/SwiftMocking/matching-arguments#Match-any-or-exactly-one":{"url":"\/tutorials\/swiftmocking\/matching-arguments#Match-any-or-exactly-one","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-any-or-exactly-one","role":"pseudoSymbol","abstract":[{"type":"text","text":"Stubbing "},{"code":"\"apple\"","type":"codeVoice"},{"type":"text","text":" and verifying "},{"code":".any","type":"codeVoice"},{"type":"text","text":" is just the beginning. Real tests need finer control: "},{"type":"emphasis","inlineContent":[{"text":"any","type":"text"}]},{"type":"text","text":" amount, amounts "},{"type":"emphasis","inlineContent":[{"type":"text","text":"under"}]},{"type":"text","text":" 100, codes "},{"type":"emphasis","inlineContent":[{"type":"text","text":"in"}]},{"type":"text","text":" a range, collections "},{"type":"emphasis","inlineContent":[{"type":"text","text":"of a certain size"}]},{"type":"text","text":" — or some predicate only you can express."}],"title":"Match any — or exactly one","kind":"section","type":"section"},"chapter-matching.png":{"type":"image","alt":"A number line with three shaded ranges labeled less than, in, and greater than.","identifier":"chapter-matching.png","variants":[{"traits":["1x","light"],"url":"\/images\/SwiftMocking\/chapter-matching.png"}]},"doc://SwiftMocking/tutorials/SwiftMocking/matching-arguments":{"url":"\/tutorials\/swiftmocking\/matching-arguments","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments","type":"topic","title":"Match Arguments Precisely","role":"project","abstract":[{"type":"text","text":"Stubbing "},{"type":"codeVoice","code":"\"apple\""},{"type":"text","text":" and verifying "},{"type":"codeVoice","code":".any"},{"type":"text","text":" is just the beginning. Real tests need finer control: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"any"}]},{"text":" amount, amounts ","type":"text"},{"inlineContent":[{"type":"text","text":"under"}],"type":"emphasis"},{"type":"text","text":" 100, codes "},{"inlineContent":[{"text":"in","type":"text"}],"type":"emphasis"},{"text":" a range, collections ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"of a certain size"}]},{"type":"text","text":" — or some predicate only you can express."}]},"doc://SwiftMocking/tutorials/Table-Of-Contents/Advanced-Stubbing-and-Verification":{"type":"topic","kind":"article","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Advanced-Stubbing-and-Verification","title":"Advanced Stubbing and Verification","url":"\/tutorials\/table-of-contents\/advanced-stubbing-and-verification","abstract":[],"role":"article"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol#Mark-a-protocol-as-mockable":{"title":"Mark a protocol as mockable","abstract":[{"type":"text","text":"In this tutorial you’ll test a "},{"type":"codeVoice","code":"Store"},{"type":"text","text":" that depends on a "},{"type":"codeVoice","code":"PricingService"},{"type":"text","text":" — without writing a mock class by hand. You’ll mark a protocol with "},{"type":"codeVoice","code":"@Mockable"},{"type":"text","text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it."}],"role":"pseudoSymbol","kind":"section","type":"section","url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol#Mark-a-protocol-as-mockable","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Mark-a-protocol-as-mockable"},"doc://SwiftMocking/tutorials/SwiftMocking/matching-arguments#Capture-and-inspect-arguments":{"role":"pseudoSymbol","url":"\/tutorials\/swiftmocking\/matching-arguments#Capture-and-inspect-arguments","abstract":[{"text":"Stubbing ","type":"text"},{"type":"codeVoice","code":"\"apple\""},{"text":" and verifying ","type":"text"},{"type":"codeVoice","code":".any"},{"text":" is just the beginning. Real tests need finer control: ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"any"}]},{"type":"text","text":" amount, amounts "},{"inlineContent":[{"text":"under","type":"text"}],"type":"emphasis"},{"text":" 100, codes ","type":"text"},{"inlineContent":[{"text":"in","type":"text"}],"type":"emphasis"},{"text":" a range, collections ","type":"text"},{"inlineContent":[{"text":"of a certain size","type":"text"}],"type":"emphasis"},{"text":" — or some predicate only you can express.","type":"text"}],"title":"Capture and inspect arguments","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Capture-and-inspect-arguments","type":"section","kind":"section"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Drive-callback-based-APIs":{"type":"section","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Drive-callback-based-APIs","role":"pseudoSymbol","abstract":[{"type":"text","text":"Fixed return values only go so far. Real dependencies "},{"inlineContent":[{"text":"compute","type":"text"}],"type":"emphasis"},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}],"title":"Drive callback-based APIs","kind":"section","url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Drive-callback-based-APIs"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Check-Your-Understanding":{"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Check-Your-Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"title":"Check Your Understanding","type":"link","url":"\/tutorials\/swiftmocking\/verifying-interactions#Check-Your-Understanding"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol":{"url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol","estimatedTime":"10min","kind":"project","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol","type":"topic","title":"Mock Your First Protocol","role":"project","abstract":[{"text":"In this tutorial you’ll test a ","type":"text"},{"code":"Store","type":"codeVoice"},{"text":" that depends on a ","type":"text"},{"code":"PricingService","type":"codeVoice"},{"text":" — without writing a mock class by hand. You’ll mark a protocol with ","type":"text"},{"code":"@Mockable","type":"codeVoice"},{"text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it.","type":"text"}]},"02-3-1-captured.swift":{"type":"file","syntax":"swift","highlights":[],"fileType":"swift","content":["func testCapturedArguments() {","    let mock = MockOrderService()","","    when(mock.validate(items: .any, coupon: .any)).thenReturn(true)","    _ = mock.validate(items: [\"apple\", \"banana\"], coupon: \"SUMMER\")","    _ = mock.validate(items: [\"cherry\"], coupon: nil)","","    \/\/ The matcher selects invocations; captured replays each one","    \/\/ with its concrete, fully typed arguments.","    verify(mock.validate(items: .any, coupon: .equal(\"SUMMER\")))","        .captured { items, coupon in","            XCTAssertEqual(items, [\"apple\", \"banana\"])","            XCTAssertEqual(coupon, \"SUMMER\")","        }","}"],"fileName":"OrderServiceTests.swift","identifier":"02-3-1-captured.swift"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol#Check-Your-Understanding":{"url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol#Check-Your-Understanding","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Check-Your-Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link","title":"Check Your Understanding"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Assert-call-counts":{"url":"\/tutorials\/swiftmocking\/verifying-interactions#Assert-call-counts","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Assert-call-counts","kind":"section","type":"section","title":"Assert call counts","role":"pseudoSymbol","abstract":[{"type":"text","text":"You’ve verified counts and matched arguments. This page completes the toolkit: asserting a call happened "},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"text":", proving a mock was ","type":"text"},{"inlineContent":[{"type":"text","text":"untouched"}],"type":"emphasis"},{"text":", and — the signature feature — verifying the ","type":"text"},{"inlineContent":[{"text":"order","type":"text"}],"type":"emphasis"},{"text":" of calls as they happened across multiple mocks.","type":"text"}]},"02-1-2-any-and-exact.swift":{"content":["import SwiftMocking","import XCTest","","final class OrderServiceTests: XCTestCase {","    func testAnyVersusExact() {","        let mock = MockOrderService()","","        \/\/ The fallback: answers every call, whatever the amount.","        when(mock.discount(forAmountCents: .any)).thenReturn(100)","","        \/\/ More specific: wins for this exact amount.","        when(mock.discount(forAmountCents: 999)).thenReturn(200)","","        XCTAssertEqual(mock.discount(forAmountCents: 999), 200)","        XCTAssertEqual(mock.discount(forAmountCents: 199), 100)","","        \/\/ The literal 199 behaves as .equal(199) in verifications too.","        verify(mock.discount(forAmountCents: 199)).called()","    }","}"],"syntax":"swift","fileName":"OrderServiceTests.swift","identifier":"02-1-2-any-and-exact.swift","type":"file","highlights":[],"fileType":"swift"},"intro-matching.png":{"alt":"A magnifying glass hovering over two recorded invocations and their argument values.","variants":[{"url":"\/images\/SwiftMocking\/intro-matching.png","traits":["1x","light"]}],"type":"image","identifier":"intro-matching.png"},"doc://SwiftMocking/tutorials/SwiftMocking/matching-arguments#Check-Your-Understanding":{"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Check-Your-Understanding","url":"\/tutorials\/swiftmocking\/matching-arguments#Check-Your-Understanding","type":"link","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"title":"Check Your Understanding"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing":{"title":"Stub Dynamically","estimatedTime":"10min","abstract":[{"type":"text","text":"Fixed return values only go so far. Real dependencies "},{"type":"emphasis","inlineContent":[{"text":"compute","type":"text"}]},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}],"role":"project","kind":"project","type":"topic","url":"\/tutorials\/swiftmocking\/dynamic-stubbing","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing"},"doc://SwiftMocking/tutorials/SwiftMocking/matching-arguments#Match-with-predicates-and-ranges":{"role":"pseudoSymbol","url":"\/tutorials\/swiftmocking\/matching-arguments#Match-with-predicates-and-ranges","abstract":[{"type":"text","text":"Stubbing "},{"code":"\"apple\"","type":"codeVoice"},{"type":"text","text":" and verifying "},{"code":".any","type":"codeVoice"},{"type":"text","text":" is just the beginning. Real tests need finer control: "},{"inlineContent":[{"text":"any","type":"text"}],"type":"emphasis"}