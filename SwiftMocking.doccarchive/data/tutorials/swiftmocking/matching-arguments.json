hat Swift Testing adds on top: ","type":"text"},{"inlineContent":[{"type":"text","text":"traits"}],"type":"strong"},{"text":", which scope behavior to a test or a whole suite.","type":"text"}],"title":"Use the rest of Swift Testing's vocabulary","role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Use-the-rest-of-Swift-Testings-vocabulary"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing":{"kind":"project","url":"\/tutorials\/swiftmocking\/dynamic-stubbing","type":"topic","title":"Stub Dynamically","abstract":[{"type":"text","text":"Fixed return values only go so far. Real dependencies "},{"type":"emphasis","inlineContent":[{"text":"compute","type":"text"}]},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}],"role":"project","estimatedTime":"20min","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing"},"02-3-3-captured.swift":{"highlights":[{"line":14},{"line":15},{"line":16}],"fileType":"swift","type":"file","fileName":"OrderServiceTests.swift","content":["@Test","func capturedArguments() {","    let mock = MockOrderService()","","    when(mock.validate(items: .any, coupon: .any)).thenReturn(true)","    _ = mock.validate(items: [\"apple\", \"banana\"], coupon: \"SUMMER\")","    _ = mock.validate(items: [\"cherry\"], coupon: nil)","","    \/\/ The matcher selects invocations; captured replays each one","    \/\/ with its concrete, fully typed arguments.","    verify(mock.validate(items: .any, coupon: .equal(\"SUMMER\")))","        .captured { items, coupon in","            #expect(items == [\"apple\", \"banana\"])","            #expect(coupon == \"SUMMER\")","        }","}"],"identifier":"02-3-3-captured.swift","syntax":"swift"},"02-1-1-order-service.swift":{"highlights":[],"fileType":"swift","fileName":"OrderService.swift","type":"file","content":["import SwiftMocking","","@Mockable"