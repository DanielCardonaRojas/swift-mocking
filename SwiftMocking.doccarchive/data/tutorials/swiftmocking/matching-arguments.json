{"hierarchy":{"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","modules":[{"projects":[{"sections":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Mark-a-protocol-as-mockable","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Create-the-system-under-test","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Stub-return-values-with-when","kind":"task"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Verify-the-interaction"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Getting-Started"},{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-any-or-exactly-one"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-with-predicates-and-ranges"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Capture-and-inspect-arguments"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Argument-Matching"},{"projects":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing","sections":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Return-computed-values","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Order-your-stubs","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Understand-matcher-precedence","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Run-side-effects-with-do","kind":"task"},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Drive-callback-based-APIs","kind":"task"}]},{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions","sections":[{"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Assert-call-counts","kind":"task"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-order-across-mocks"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-thrown-errors"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Wait-for-calls-that-havent-happened-yet"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-property-reads-and-writes"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Debug-failing-verifications"}]}],"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Advanced-Stubbing-and-Verification"},{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Control-what-unstubbed-requirements-return"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Mock-static-requirements-safely"},{"kind":"task","reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Use-the-rest-of-Swift-Testings-vocabulary"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration"}],"reference":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Swift-Testing-Integration"}],"paths":[["doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/$volume","doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Argument-Matching"]]},"sections":[{"estimatedTimeInMinutes":10,"title":"Match Arguments Precisely","kind":"hero","image":"intro-matching.png","backgroundImage":"intro-matching.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stubbing "},{"code":"\"apple\"","type":"codeVoice"},{"text":" and verifying ","type":"text"},{"code":".any","type":"codeVoice"},{"text":" is just the beginning. Real tests need finer control: ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"any"}]},{"text":" amount, amounts ","type":"text"},{"inlineContent":[{"text":"under","type":"text"}],"type":"emphasis"},{"text":" 100, codes ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"in","type":"text"}]},{"text":" a range, collections ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"of a certain size","type":"text"}]},{"type":"text","text":" — or some predicate only you can express."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In this tutorial you’ll drive an "},{"type":"codeVoice","code":"OrderService"},{"type":"text","text":" through the full matcher vocabulary, then reach the arguments your code actually passed with "},{"type":"codeVoice","code":"captured"},{"type":"text","text":"."}]}],"chapter":"Argument Matching"},{"kind":"tasks","tasks":[{"contentSection":[{"mediaPosition":"trailing","media":"chapter-matching.png","content":[{"inlineContent":[{"text":"Every argument position in a ","type":"text"},{"type":"codeVoice","code":"when"},{"type":"text","text":" or "},{"type":"codeVoice","code":"verify"},{"type":"text","text":" call takes an "},{"type":"codeVoice","code":"ArgMatcher"},{"text":". Two extremes cover most cases: ","type":"text"},{"code":".any","type":"codeVoice"},{"text":" matches everything, while ","type":"text"},{"type":"codeVoice","code":".equal"},{"type":"text","text":" — or a plain literal, thanks to literal conformances — matches one exact value."}],"type":"paragraph"}],"kind":"contentAndMedia"}],"stepsSection":[{"type":"step","caption":[],"code":"02-1-1-order-service.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Create ","type":"text"},{"code":"OrderService.swift","type":"codeVoice"},{"text":" with a protocol that prices orders in cents and validates item lists:","type":"text"}]}],"runtimePreview":null},{"type":"step","caption":[],"code":"02-1-2-any-and-exact.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Start a test with just the mock in place, so you can watch the matchers accumulate one at a time.","type":"text"}]}],"runtimePreview":null},{"type":"step","caption":[],"code":"02-1-3-any-and-exact.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Register the broad stub first. ","type":"text"},{"type":"codeVoice","code":".any"},{"text":" matches every ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":", so at this point every amount you ask about returns ","type":"text"},{"code":"100","type":"codeVoice"},{"text":".","type":"text"}]}],"runtimePreview":null},{"type":"step","caption":[],"code":"02-1-4-any-and-exact.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Now layer a specific stub on top. ","type":"text"},{"type":"codeVoice","code":"999"},{"type":"text","text":" narrows to "},{"type":"codeVoice","code":".equal(999)"},{"text":", and because it’s the more specific matcher it wins for that amount — while ","type":"text"},{"code":"199","type":"codeVoice"},{"text":" still falls through to ","type":"text"},{"code":".any","type":"codeVoice"},{"text":".","type":"text"}]}],"runtimePreview":null},{"type":"step","caption":[],"code":"02-1-5-any-and-exact.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The same literal sugar works in verifications: "},{"type":"codeVoice","code":"verify(mock.discount(forAmountCents: 199))"},{"type":"text","text":" counts only the calls that passed "},{"type":"codeVoice","code":"199"},{"text":".","type":"text"}]}],"runtimePreview":null},{"type":"step","caption":[],"code":null,"media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Optional arguments have their own matchers — ","type":"text"},{"type":"codeVoice","code":".notNil()"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".nil()"},{"text":" — and they read naturally in both directions: ","type":"text"},{"type":"codeVoice","code":"when(mock.validate(items: .any, coupon: .nil())).thenReturn(true)"},{"text":" stubs only coupon-less validations, while ","type":"text"},{"type":"codeVoice","code":"verify(mock.validate(items: .any, coupon: .notNil())).called(1)"},{"text":" counts the rest.","type":"text"}]}],"runtimePreview":null}],"title":"Match any — or exactly one","anchor":"Match-any-or-exactly-one"},{"contentSection":[{"mediaPosition":"trailing","media":"chapter-matching.png","content":[{"type":"paragraph","inlineContent":[{"text":"When the boundary matters more than the value, reach for comparison and range matchers. They mirror Swift’s own vocabulary: ","type":"text"},{"type":"codeVoice","code":".lessThan"},{"text":", ","type":"text"},{"type":"codeVoice","code":".greaterThan"},{"text":", ","type":"text"},{"type":"codeVoice","code":".in(...)"},{"text":" with any range expression, and ","type":"text"},{"type":"codeVoice","code":".hasCount(in:)"},{"text":" for collections.","type":"text"}]}],"kind":"contentAndMedia"}],"stepsSection":[{"type":"step","caption":[],"code":"02-2-1-predicates-and-ranges.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Add a second test to the same class, starting from a fresh mock.","type":"text"}]}],"runtimePreview":null},{"type":"step","caption":[],"code":"02-2-2-predicates-and-ranges.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Build a discount ladder out of three non-overlapping bands. ","type":"text"},{"type":"codeVoice","code":".lessThan"},{"text":", ","type":"text"},{"type":"codeVoice","code":".in(_:)"},{"text":" with a closed range, and ","type":"text"},{"type":"codeVoice","code":".greaterThan"},{"text":" between them cover every possible amount exactly once.","type":"text"}]}],"runtimePreview":null},{"type":"step","caption":[],"code":"02-2-3-predicates-and-ranges.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"Probe one amount per band to prove each boundary routes where you expect.","type":"text"}]}],"runtimePreview":null},{"type":"step","caption":[],"code":"02-2-4-predicates-and-ranges.swift","media":null,"content":[{"type":"paragraph","inlineContent":[{"text":"For everything else there’s ","type":"text"},{"type":"codeVoice","code":".any(that:)"},{"text":": your closure becomes the matcher, and it receives the real argument — an ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":", not ","type":"text"},{"type":"codeVoice","code":"Any"},{"text":" — so it type-checks like ordinary Swift. Here it counts round amounts: of the three calls above only ","type":"text"},{"type":"codeVoice","code":"500"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"5000"},{"text":" are multiples of 100, so the assertion expects exactly two. ","type":"text"},{"type":"codeVoice","code":".hasCount(in:)"},{"text":" applies the same idea to a collection’s length.","type":"text"}]}],"runtimePreview":null}],"title":"Match with predicates and ranges","anchor":"Match-with-predicates-and-ranges"},{"title":"Capture and inspect arguments","stepsSection":[{"content":[{"inlineContent":[{"type":"text","text":"Record two validations that differ in both arguments — one with a coupon, one without. A permissive "},{"type":"codeVoice","code":".any"},{"type":"text","text":" stub lets both calls through so there’s something to inspect."}],"type":"paragraph"}],"code":"02-3-1-captured.swift","type":"step","caption":[],"runtimePreview":null,"media":null},{"content":[{"inlineContent":[{"type":"text","text":"Narrow the capture to the coupon-bearing call, then assert against the concrete arguments. "},{"type":"codeVoice","code":"items"},{"type":"text","text":" arrives as a real "},{"type":"codeVoice","code":"[String]"},{"text":" and ","type":"text"},{"code":"coupon","type":"codeVoice"},{"text":" as a ","type":"text"},{"code":"String?","type":"codeVoice"},{"text":" — no casting, and the compiler checks your assertions.","type":"text"}],"type":"paragraph"}],"code":"02-3-2-captured.swift","type":"step","caption":[],"runtimePreview":null,"media":null},{"content":[{"inlineContent":[{"text":"Close the closure and the test. Filter and inspect compose freely: the matcher selects the invocations, ","type":"text"},{"type":"codeVoice","code":"captured"},{"text":" shows you them. If no invocation matches, the verification reports a failed call count instead of silently skipping your assertions.","type":"text"}],"type":"paragraph"}],"code":"02-3-3-captured.swift","type":"step","caption":[],"runtimePreview":null,"media":null}],"contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"Matchers assert; sometimes you want to "},{"inlineContent":[{"text":"examine","type":"text"}],"type":"emphasis"},{"type":"text","text":". "},{"type":"codeVoice","code":"captured"},{"type":"text","text":" replays each matching invocation through a closure, handing you the concrete arguments your production code passed — perfect for invariants that don’t reduce to a single equality check."}],"type":"paragraph"}],"kind":"contentAndMedia","media":"intro-matching.png","mediaPosition":"trailing"}],"anchor":"Capture-and-inspect-arguments"}]},{"featuredEyebrow":"Tutorial","title":"Stub Dynamically","kind":"callToAction","abstract":[{"type":"text","text":"Fixed return values only go so far. Real dependencies "},{"inlineContent":[{"text":"compute","type":"text"}],"type":"emphasis"},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}],"action":{"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing","type":"reference","isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}]}}],"metadata":{"category":"SwiftMocking","title":"Match Arguments Precisely","categoryPathComponent":"Table-Of-Contents","role":"project"},"kind":"project","identifier":{"url":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/tutorials\/swiftmocking\/matching-arguments"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftMocking/tutorials/SwiftMocking/matching-arguments#Match-with-predicates-and-ranges":{"type":"section","abstract":[{"type":"text","text":"Stubbing "},{"type":"codeVoice","code":"\"apple\""},{"text":" and verifying ","type":"text"},{"code":".any","type":"codeVoice"},{"text":" is just the beginning. Real tests need finer control: ","type":"text"},{"inlineContent":[{"type":"text","text":"any"}],"type":"emphasis"},{"text":" amount, amounts ","type":"text"},{"inlineContent":[{"type":"text","text":"under"}],"type":"emphasis"},{"text":" 100, codes ","type":"text"},{"inlineContent":[{"text":"in","type":"text"}],"type":"emphasis"},{"text":" a range, collections ","type":"text"},{"inlineContent":[{"type":"text","text":"of a certain size"}],"type":"emphasis"},{"text":" — or some predicate only you can express.","type":"text"}],"title":"Match with predicates and ranges","url":"\/tutorials\/swiftmocking\/matching-arguments#Match-with-predicates-and-ranges","kind":"section","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/matching-arguments#Match-with-predicates-and-ranges","role":"pseudoSymbol"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Return-computed-values":{"kind":"section","url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Return-computed-values","type":"section","abstract":[{"text":"Fixed return values only go so far. Real dependencies ","type":"text"},{"inlineContent":[{"type":"text","text":"compute"}],"type":"emphasis"},{"text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks.","type":"text"}],"title":"Return computed values","role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Return-computed-values"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions":{"kind":"project","url":"\/tutorials\/swiftmocking\/verifying-interactions","type":"topic","title":"Verify Every Interaction","abstract":[{"type":"text","text":"You’ve verified counts and matched arguments. This page completes the toolkit: counting calls with the full matcher vocabulary, asserting a call happened "},{"inlineContent":[{"text":"never","type":"text"}],"type":"emphasis"},{"type":"text","text":", proving a mock was "},{"inlineContent":[{"text":"untouched","type":"text"}],"type":"emphasis"},{"type":"text","text":", verifying thrown errors, waiting for calls that arrive from another task, distinguishing property reads from writes, and — the signature feature — verifying the "},{"inlineContent":[{"text":"order","type":"text"}],"type":"emphasis"},{"type":"text","text":" of calls across multiple mocks."}],"role":"project","estimatedTime":"20min","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Drive-callback-based-APIs":{"type":"section","abstract":[{"type":"text","text":"Fixed return values only go so far. Real dependencies "},{"type":"emphasis","inlineContent":[{"type":"text","text":"compute"}]},{"type":"text","text":": a calculator multiplies its operands, a sync engine mutates state, a network service delivers results through callbacks."}],"title":"Drive callback-based APIs","url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Drive-callback-based-APIs","kind":"section","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/dynamic-stubbing#Drive-callback-based-APIs","role":"pseudoSymbol"},"02-1-5-any-and-exact.swift":{"highlights":[{"line":18},{"line":19},{"line":20},{"line":21},{"line":22}],"fileType":"swift","fileName":"OrderServiceTests.swift","type":"file","content":["import SwiftMocking","import Testing","","@Suite","struct OrderServiceTests {","    @Test","    func anyVersusExact() {","        let mock = MockOrderService()","","        \/\/ The fallback: answers every call, whatever the amount.","        when(mock.discount(forAmountCents: .any)).thenReturn(100)","","        \/\/ More specific: wins for this exact amount.","        when(mock.discount(forAmountCents: 999)).thenReturn(200)","","        #expect(mock.discount(forAmountCents: 999) == 200)","        #expect(mock.discount(forAmountCents: 199) == 100)","","        \/\/ The literal 199 behaves as .equal(199) in verifications too.","        verify(mock.discount(forAmountCents: 199)).called()","    }","}"],"identifier":"02-1-5-any-and-exact.swift","syntax":"swift"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Verify-order-across-mocks":{"abstract":[{"text":"You’ve verified counts and matched arguments. This page completes the toolkit: counting calls with the full matcher vocabulary, asserting a call happened ","type":"text"},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"text":", proving a mock was ","type":"text"},{"inlineContent":[{"type":"text","text":"untouched"}],"type":"emphasis"},{"text":", verifying thrown errors, waiting for calls that arrive from another task, distinguishing property reads from writes, and — the signature feature — verifying the ","type":"text"},{"inlineContent":[{"type":"text","text":"order"}],"type":"emphasis"},{"text":" of calls across multiple mocks.","type":"text"}],"role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-order-across-mocks","type":"section","kind":"section","url":"\/tutorials\/swiftmocking\/verifying-interactions#Verify-order-across-mocks","title":"Verify order across mocks"},"doc://SwiftMocking/tutorials/Table-Of-Contents/Getting-Started":{"abstract":[],"role":"article","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Getting-Started","type":"topic","kind":"article","url":"\/tutorials\/table-of-contents\/getting-started","title":"Getting Started"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol":{"kind":"project","url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol","type":"topic","title":"Mock Your First Protocol","abstract":[{"text":"In this tutorial you’ll test a ","type":"text"},{"code":"Store","type":"codeVoice"},{"text":" that depends on a ","type":"text"},{"code":"PricingService","type":"codeVoice"},{"text":" — without writing a mock class by hand. You’ll mark a protocol with ","type":"text"},{"code":"@Mockable","type":"codeVoice"},{"text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it.","type":"text"}],"role":"project","estimatedTime":"10min","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol"},"doc://SwiftMocking/tutorials/SwiftMocking/mocking-your-first-protocol#Stub-return-values-with-when":{"kind":"section","url":"\/tutorials\/swiftmocking\/mocking-your-first-protocol#Stub-return-values-with-when","type":"section","abstract":[{"text":"In this tutorial you’ll test a ","type":"text"},{"code":"Store","type":"codeVoice"},{"text":" that depends on a ","type":"text"},{"code":"PricingService","type":"codeVoice"},{"text":" — without writing a mock class by hand. You’ll mark a protocol with ","type":"text"},{"code":"@Mockable","type":"codeVoice"},{"text":", let the macro generate the mock, stub what its method returns, and verify that your code actually called it.","type":"text"}],"title":"Stub return values with when","role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/mocking-your-first-protocol#Stub-return-values-with-when"},"02-3-1-captured.swift":{"highlights":[],"identifier":"02-3-1-captured.swift","syntax":"swift","fileName":"OrderServiceTests.swift","type":"file","content":["@Test","func capturedArguments() {","    let mock = MockOrderService()","","    when(mock.validate(items: .any, coupon: .any)).thenReturn(true)","    _ = mock.validate(items: [\"apple\", \"banana\"], coupon: \"SUMMER\")","    _ = mock.validate(items: [\"cherry\"], coupon: nil)"],"fileType":"swift"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Assert-call-counts":{"abstract":[{"text":"You’ve verified counts and matched arguments. This page completes the toolkit: counting calls with the full matcher vocabulary, asserting a call happened ","type":"text"},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"text":", proving a mock was ","type":"text"},{"inlineContent":[{"type":"text","text":"untouched"}],"type":"emphasis"},{"text":", verifying thrown errors, waiting for calls that arrive from another task, distinguishing property reads from writes, and — the signature feature — verifying the ","type":"text"},{"inlineContent":[{"type":"text","text":"order"}],"type":"emphasis"},{"text":" of calls across multiple mocks.","type":"text"}],"role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Assert-call-counts","type":"section","kind":"section","url":"\/tutorials\/swiftmocking\/verifying-interactions#Assert-call-counts","title":"Assert call counts"},"doc://SwiftMocking/tutorials/SwiftMocking/verifying-interactions#Verify-thrown-errors":{"identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/verifying-interactions#Verify-thrown-errors","kind":"section","type":"section","role":"pseudoSymbol","title":"Verify thrown errors","abstract":[{"type":"text","text":"You’ve verified counts and matched arguments. This page completes the toolkit: counting calls with the full matcher vocabulary, asserting a call happened "},{"inlineContent":[{"type":"text","text":"never"}],"type":"emphasis"},{"type":"text","text":", proving a mock was "},{"inlineContent":[{"text":"untouched","type":"text"}],"type":"emphasis"},{"type":"text","text":", verifying thrown errors, waiting for calls that arrive from another task, distinguishing property reads from writes, and — the signature feature — verifying the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"order"}]},{"text":" of calls across multiple mocks.","type":"text"}],"url":"\/tutorials\/swiftmocking\/verifying-interactions#Verify-thrown-errors"},"02-1-4-any-and-exact.swift":{"highlights":[{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17}],"identifier":"02-1-4-any-and-exact.swift","syntax":"swift","fileName":"OrderServiceTests.swift","type":"file","content":["import SwiftMocking","import Testing","","@Suite","struct OrderServiceTests {","    @Test","    func anyVersusExact() {","        let mock = MockOrderService()","","        \/\/ The fallback: answers every call, whatever the amount.","        when(mock.discount(forAmountCents: .any)).thenReturn(100)","","        \/\/ More specific: wins for this exact amount.","        when(mock.discount(forAmountCents: 999)).thenReturn(200)","","        #expect(mock.discount(forAmountCents: 999) == 200)","        #expect(mock.discount(forAmountCents: 199) == 100)"],"fileType":"swift"},"02-2-4-predicates-and-ranges.swift":{"highlights":[{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19}],"fileType":"swift","type":"file","fileName":"OrderServiceTests.swift","content":["@Test","func predicatesAndRanges() {","    let mock = MockOrderService()","","    when(mock.discount(forAmountCents: .lessThan(100))).thenReturn(0)","    when(mock.discount(forAmountCents: .in(100...999))).thenReturn(50)","    when(mock.discount(forAmountCents: .greaterThan(999))).thenReturn(150)","","    #expect(mock.discount(forAmountCents: 50) == 0)","    #expect(mock.discount(forAmountCents: 500) == 50)","    #expect(mock.discount(forAmountCents: 5000) == 150)","","    \/\/ Any predicate you can express as a closure becomes a matcher.","    let roundAmounts = ArgMatcher<Int>.any(that: { $0.isMultiple(of: 100) })","    verify(mock.discount(forAmountCents: roundAmounts)).called(2)","","    \/\/ Collections match by count: at most three items.","    verify(mock.validate(items: .hasCount(in: ...3), coupon: .any)).neverCalled()","}"],"identifier":"02-2-4-predicates-and-ranges.swift","syntax":"swift"},"doc://SwiftMocking/tutorials/Table-Of-Contents":{"kind":"overview","type":"topic","url":"\/tutorials\/table-of-contents","role":"overview","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents","abstract":[{"text":"Stop hand-writing mock classes. With SwiftMocking, one ","type":"text"},{"type":"codeVoice","code":"@Mockable"},{"text":" annotation turns any protocol into a fully featured mock: stub return values, match arguments with expressive matchers, drive callbacks, and verify every interaction — all type-safe, all local, no code generation steps in your build.","type":"text"}],"title":"Meet SwiftMocking"},"doc://SwiftMocking/tutorials/Table-Of-Contents/Argument-Matching":{"type":"topic","abstract":[],"title":"Argument Matching","url":"\/tutorials\/table-of-contents\/argument-matching","kind":"article","identifier":"doc:\/\/SwiftMocking\/tutorials\/Table-Of-Contents\/Argument-Matching","role":"article"},"02-3-2-captured.swift":{"highlights":[{"line":8},{"line":9},{"line":10},{"line":11},{"line":12},{"line":13}],"fileType":"swift","type":"file","fileName":"OrderServiceTests.swift","content":["@Test","func capturedArguments() {","    let mock = MockOrderService()","","    when(mock.validate(items: .any, coupon: .any)).thenReturn(true)","    _ = mock.validate(items: [\"apple\", \"banana\"], coupon: \"SUMMER\")","    _ = mock.validate(items: [\"cherry\"], coupon: nil)","","    \/\/ The matcher selects invocations; captured replays each one","    \/\/ with its concrete, fully typed arguments.","    verify(mock.validate(items: .any, coupon: .equal(\"SUMMER\")))","        .captured { items, coupon in","            #expect(items == [\"apple\", \"banana\"])"],"identifier":"02-3-2-captured.swift","syntax":"swift"},"doc://SwiftMocking/tutorials/SwiftMocking/testing-integration#Mock-static-requirements-safely":{"abstract":[{"text":"Every test so far has been an ordinary ","type":"text"},{"code":"@Test","type":"codeVoice"},{"text":". This page covers what Swift Testing adds on top: ","type":"text"},{"type":"strong","inlineContent":[{"text":"traits","type":"text"}]},{"text":", which scope behavior to a test or a whole suite.","type":"text"}],"role":"pseudoSymbol","identifier":"doc:\/\/SwiftMocking\/tutorials\/SwiftMocking\/testing-integration#Mock-static-requirements-safely","type":"section","title":"Mock static requirements safely","url":"\/tutorials\/swiftmocking\/testing-integration#Mock-static-requirements-safely","kind":"section"},"02-2-2-predicates-and-ranges.swift":{"highlights":[{"line":4},{"line":5},{"line":6},{"line":7}],"fileType":"swift","type":"file","fileName":"OrderServiceTests.swift","content":["@Test","func predicatesAndRanges() {","    let mock = MockOrderService()","","    when(mock.discount(forAmountCents: .lessThan(100))).thenReturn(0)","    when(mock.discount(forAmountCents: .in(100...999))).thenReturn(50)","    when(mock.discount(forAmountCents: .greaterThan(999))).thenReturn(150)"],"identifier":"02-2-2-predicates-and-ranges.swift","syntax":"swift"},"doc://SwiftMocking/tutorials/SwiftMocking/dynamic-stubbing#Understand-matcher-precedence":{"kind":"section","url":"\/tutorials\/swiftmocking\/dynamic-stubbing#Understand-matcher-precedence","type":"section","abstract":[{"text":"Fixed return values only go so far. Real dependencies ","type":"text"},{"inlineContent":[{"type":"text","text":"compute"}],"type":"emphasis"},{"text":": a calculator multipl