{"metadata":{"symbolKind":"struct","role":"symbol","modules":[{"name":"SwiftMocking"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MatcherPrecedence","kind":"identifier"}],"title":"MatcherPrecedence","roleHeading":"Structure","externalID":"s:12SwiftMocking17MatcherPrecedenceV","navigatorTitle":[{"kind":"identifier","text":"MatcherPrecedence"}]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MatcherPrecedence","kind":"identifier"}],"languages":["swift"]}]},{"content":[{"anchor":"Why-this-exists","text":"Why this exists","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Stubs are additive: registering "},{"code":".any","type":"codeVoice"},{"text":" doesn’t replace an earlier ","type":"text"},{"code":".equal(5)","type":"codeVoice"},{"text":", so a","type":"text"},{"text":" ","type":"text"},{"text":"single call frequently matches several stubs at once. Something has to break the tie.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Resolving by registration order would make tests fragile — moving a "},{"type":"codeVoice","code":"when"},{"text":" line, or","type":"text"},{"text":" ","type":"text"},{"text":"extracting shared setup into a helper, would silently change behavior. Instead each","type":"text"},{"text":" ","type":"text"},{"text":"matcher carries a precedence, and the ","type":"text"},{"inlineContent":[{"text":"most specific matching stub wins regardless of","type":"text"},{"text":" ","type":"text"},{"text":"the order the stubs were registered in","type":"text"}],"type":"strong"},{"text":". That lets you write a broad fallback next to","type":"text"},{"text":" ","type":"text"},{"text":"narrow special cases and read the result off the matchers alone:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["when(mock.rate(forAmount: .any)).thenReturn(\"any\")               \/\/   0","when(mock.rate(forAmount: .greaterThan(100))).thenReturn(\"high\") \/\/ 200","when(mock.rate(forAmount: 500)).thenReturn(\"exact\")              \/\/ 500","","service.rate(forAmount: 500)  \/\/ \"exact\"  — 500 outranks 200 and 0","service.rate(forAmount: 250)  \/\/ \"high\"   — 200 outranks 0","service.rate(forAmount: 5)    \/\/ \"any\"    — the only stub that matches"]},{"level":2,"type":"heading","anchor":"The-ladder","text":"The ladder"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Precedence"}]}],[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Matchers","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/any","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"0","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":".any","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/typeMatch","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"100"}]}],[{"type":"paragraph","inlineContent":[{"code":".any(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":".is"},{"type":"text","text":", "},{"code":".as","type":"codeVoice"},{"text":", ","type":"text"},{"code":".hasCount","type":"codeVoice"},{"text":", ","type":"text"},{"code":".anyError","type":"codeVoice"}]}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/predicate"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"200"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".any(that:)"},{"type":"text","text":", "},{"type":"codeVoice","code":".lessThan"},{"type":"text","text":", "},{"type":"codeVoice","code":".greaterThan"},{"type":"text","text":", "},{"type":"codeVoice","code":".in"},{"type":"text","text":", "},{"type":"codeVoice","code":".between"},{"type":"text","text":", "},{"type":"codeVoice","code":".notNil"},{"type":"text","text":", "},{"type":"codeVoice","code":".nil"},{"type":"text","text":", "},{"type":"codeVoice","code":".contains"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/equalTo","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"500","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":".equal","type":"codeVoice"},{"text":", and bare literals like ","type":"text"},{"code":"5","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"\"apple\"","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/identicalTo","type":"reference","isActive":true}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"600"}]}],[{"type":"paragraph","inlineContent":[{"code":".identical","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/customHigh","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"700","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"available for your own matchers"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/customExtreme","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"999"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"available for your own matchers"}]}]]],"header":"row"},{"anchor":"Multi-argument-calls-sum-their-matchers","type":"heading","text":"Multi-argument calls sum their matchers","level":2},{"inlineContent":[{"type":"text","text":"For a method with several parameters the precedences are "},{"type":"strong","inlineContent":[{"type":"text","text":"added together"}]},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"specificity is a property of the whole call rather than any single argument:"}],"type":"paragraph"},{"code":["\/\/ (.greaterThan, .any(that:)) = 200 + 200 = 400","when(mock.fee(amount: .greaterThan(0), currency: .any(that: { !$0.isEmpty })))","    .thenReturn(\"both predicates\")","","\/\/ (.equal, .any)              = 500 +   0 = 500  ← wins","when(mock.fee(amount: 100, currency: .any)).thenReturn(\"one exact\")","","service.fee(amount: 100, currency: \"USD\")  \/\/ \"one exact\""],"type":"codeListing","syntax":"swift"},{"anchor":"Ties","type":"heading","text":"Ties","level":2},{"inlineContent":[{"text":"Two stubs with the ","type":"text"},{"inlineContent":[{"type":"text","text":"same"}],"type":"emphasis"},{"text":" total precedence — most often two registrations of the same","type":"text"},{"text":" ","type":"text"},{"text":"matcher — are resolved by recency: the later registration wins. This is the only case","type":"text"},{"text":" ","type":"text"},{"text":"where the order of your ","type":"text"},{"code":"when","type":"codeVoice"},{"text":" calls matters.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Overriding the ladder","anchor":"Overriding-the-ladder","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/customHigh","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/customExtreme","isActive":true,"type":"reference"},{"text":" sit above every built-in tier, so a hand-built","type":"text"},{"text":" ","type":"text"},{"text":"matcher can outrank even ","type":"text"},{"code":".equal","type":"codeVoice"},{"text":" when you need it to:","type":"text"}]},{"type":"codeListing","code":["let roundNumbers = ArgMatcher<Int>(precedence: .customExtreme) { $0 % 100 == 0 }","","when(mock.rate(forAmount: 500)).thenReturn(\"exact\")       \/\/ 500","when(mock.rate(forAmount: roundNumbers)).thenReturn(\"vip\") \/\/ 999 ← wins"],"syntax":"swift"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Verification is unaffected by precedence. ","type":"text"},{"code":"verify(...)","type":"codeVoice"},{"text":" counts ","type":"text"},{"inlineContent":[{"type":"text","text":"every"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"invocation matching the matcher you pass; precedence only selects which stub","type":"text"},{"text":" ","type":"text"},{"text":"supplies a return value.","type":"text"}]}],"style":"note","name":"Note"}],"kind":"content"}],"topicSections":[{"anchor":"Operators","title":"Operators","identifiers":["doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/_(_:_:)"],"generated":true},{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/init(value:)"],"title":"Initializers"},{"identifiers":["doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/value"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"title":"Type Properties","identifiers":["doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/any","doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/customExtreme","doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/customHigh","doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/equalTo","doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/identicalTo","doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/MatcherPrecedence\/predicat