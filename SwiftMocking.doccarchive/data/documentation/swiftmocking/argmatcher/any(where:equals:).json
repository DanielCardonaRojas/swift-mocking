"},{"text":">, ","kind":"text"},{"text":"equals","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"value","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Property","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/ArgMatcher","text":"ArgMatcher","preciseIdentifier":"s:12SwiftMocking10ArgMatcherV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Argument","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Argument","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Property","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Equatable","preciseIdentifier":"s:SQ","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Property","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"platforms":["macOS"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"KeyPath","type":"codeVoice"},{"text":" to the property of the ","type":"text"},{"code":"Argument","type":"codeVoice"},{"text":" type that should be compared.","type":"text"}]}],"name":"keyPath"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" value to compare the property against.","type":"text"}]}],"name":"value"}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"ArgMatcher","type":"codeVoice"},{"text":" that matches arguments where the specified property equals the given value.","type":"text"}]}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is useful for matching arguments based on a nested property, especially when the argument itself"},{"type":"text","text":" "},{"type":"text","text":"might not be "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":" or when you only care about a specific part of it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Example:"}]},{"type":"codeListing","syntax":"swift","code":["struct User {","    let id: String","    let name: String","}","","protocol UserService {","    func getUser(user: User) -> User?","}","","\/\/ Stub the getUser method to return a user when the id property of the argument is \"123\"","when(mockUserService.getUser(user: .any(where: \\.id, equals: \"123\"))).thenReturn(User(id: \"123\", name: \"Test User\"))","","\/\/ Verify that getUser was called with a user whose name property is \"Alice\"","verify(mockUserService.getUser(user: .any(where: \\.name, equals: \"Alice\"))).called()"]},{"inlineContent":[{"type":"text","text":"Prefer this over "},{"type":"codeVoice","code":".any(that:)"},{"type":"text","text":" when you’re comparing a property to a value: it"},{"type":"text","text":" "},{"type":"text","text":"captures the value rather than a caller-supplied closure, so it never produces a"},{"type":"text","text":" "},{"type":"text","text":"“non-Sendable function value” warning under Swift 6 concurrency checking."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"A matcher that matches any argument where a specific property of the argument is equal to a given value."}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/ArgMatcher\/any(where:equals:)"},"hierarchy":{"paths":[["doc:\/\/SwiftMocking\/documentation\/SwiftMocking","doc:\/\/SwiftMocking\/documentation\/SwiftMocking\/ArgMatcher"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"